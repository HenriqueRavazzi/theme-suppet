{%- comment -%}
  Suppet icon mini — ícones usados nos "mini benefícios" do topo do
  produto (sections/suppet-product-hero.liquid). Extraído pra snippet
  porque o mesmo conjunto de ícones é usado tanto pelos blocks reais
  quanto pelo fallback por produto (case product.handle).
  Parâmetro: icon (string) — paw | heart | leaf | shield | bolt | star.
  Arquivo NOVO: não é sobrescrito por atualizações do tema Shapes.
{%- endcomment -%}

{%- case icon -%}
  {%- when 'paw' -%}
    <svg viewBox="0 0 24 24" fill="currentColor">
      <circle cx="6" cy="9" r="2.1"></circle>
      <circle cx="11" cy="6" r="2.1"></circle>
      <circle cx="16" cy="6" r="2.1"></circle>
      <circle cx="20" cy="10" r="2"></circle>
      <path d="M13 12.2c3.2 0 6 2.4 6 5.2 0 2-1.6 3.1-3.6 2.5-1-.3-2.1-.3-3.1 0-2 .6-3.6-.5-3.6-2.5 0-2.8 2.1-5.2 4.3-5.2Z"></path>
    </svg>
  {%- when 'leaf' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
      <path d="M4 20c0-8 5-14 16-15-1 10-7 15-15 15Z"></path>
      <path d="M6 18c3-3 6-7 12-11"></path>
    </svg>
  {%- when 'shield' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
      <path d="M12 3l7 3v5c0 4.6-3 8.4-7 10-4-1.6-7-5.4-7-10V6l7-3Z"></path>
      <path d="M9 12l2 2 4-4"></path>
    </svg>
  {%- when 'bolt' -%}
    <svg viewBox="0 0 24 24" fill="currentColor">
      <path d="M13 2 4 14h6l-1 8 9-12h-6l1-8Z"></path>
    </svg>
  {%- when 'star' -%}
    <svg viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 2.5l2.9 6.3 6.8.7-5.1 4.6 1.5 6.8-6.1-3.6-6.1 3.6 1.5-6.8-5.1-4.6 6.8-.7L12 2.5Z"></path>
    </svg>
  {%- else -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
      <path d="M12 20s-7.5-4.6-9.6-9.4C1.1 7.6 3 4.5 6.3 4.2c2-.2 3.7 1 4.7 2.6 1-1.6 2.7-2.8 4.7-2.6 3.3.3 5.2 3.4 3.9 6.4C19.5 15.4 12 20 12 20Z"></path>
      <path d="M9 11.2h1.6l1-1.7 1.4 3 1-1.3H16"></path>
    </svg>
{%- endcase -%}
