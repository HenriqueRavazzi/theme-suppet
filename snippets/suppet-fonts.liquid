{%- comment -%}
  Suppet fonts — Baloo 2 (títulos) e Nunito Sans (texto), as mesmas fontes
  da LP de referência (Suppet (1)/css/style.css: --font-head / --font-body).
  Baloo 2 não existe na biblioteca nativa de fontes do Shopify (font_picker),
  por isso as duas são auto-hospedadas aqui e sobrescrevem --heading-font-*
  e --main-font-* definidas em layout/theme.liquid + snippets/css-bridge.liquid.
  Arquivo NOVO: não é sobrescrito por atualizações do tema Shapes.
{%- endcomment -%}

{% # theme-check-disable AssetPreload %}
<link rel="preload" as="font" href="{{ 'suppet-font-baloo-2.woff2' | asset_url }}" type="font/woff2" crossorigin>
<link rel="preload" as="font" href="{{ 'suppet-font-nunito-sans.woff2' | asset_url }}" type="font/woff2" crossorigin>

{% style %}
  @font-face {
    font-family: 'Baloo 2';
    src: url('{{ 'suppet-font-baloo-2.woff2' | asset_url }}') format('woff2');
    font-weight: 500 800;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Nunito Sans';
    src: url('{{ 'suppet-font-nunito-sans.woff2' | asset_url }}') format('woff2');
    font-weight: 400 800;
    font-style: normal;
    font-display: swap;
  }

  :root {
    --heading-font-stack: 'Baloo 2', 'Nunito Sans', sans-serif;
    --heading-font-weight: 700;
    --heading-font-style: normal;
    --main-font-stack: 'Nunito Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    --main-font-weight: 400;
    --main-font-style: normal;
  }
{% endstyle %}
