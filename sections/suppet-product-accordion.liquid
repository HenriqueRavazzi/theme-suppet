{%- comment -%}
  Suppet product accordion — porte do ".accordion" da LP estática
  (Suppet/produto.html + css/style.css). Extraído de suppet-product-hero
  pra ficar posicionado depois de "O que torna [produto] único?", igual
  na LP (hero → único → sanfona → relacionados). Sem animação de altura
  ou rotação de ícone — abrir/fechar é instantâneo.
  Arquivo NOVO: não é sobrescrito por atualizações do tema Shapes.
{%- endcomment -%}

{%- liquid
  assign uid = section.id
  assign accordion_items = section.blocks | where: 'type', 'accordion_item'
  assign nutrient_rows = section.blocks | where: 'type', 'nutrient_row'
-%}

{%- comment -%}
  Sem linhas cadastradas via bloco, usa os níveis de garantia reais de
  cada fórmula (mesmos dados declarados na LP de referência), pelo
  handle do produto — assim a tabela certa aparece sozinha em cada
  página, sem precisar configurar linha por linha por produto.
{%- endcomment -%}
{%- capture nutrient_rows_html -%}
  {%- if nutrient_rows.size > 0 -%}
    {%- for row in nutrient_rows -%}
      <tr {{ row.shopify_attributes }}>
        <td>{{ row.settings.nutrient }}</td>
        <td>{{ row.settings.per_kg }}</td>
        <td>{{ row.settings.per_unit }}</td>
      </tr>
    {%- endfor -%}
  {%- else -%}
    {%- case product.handle -%}
      {%- when 'campo-de-vitaforca' -%}
        <tr><td>Vitamina A</td><td>178.500 UI</td><td>714 UI</td></tr>
        <tr><td>Vitamina E</td><td>2.975 UI</td><td>11,9 UI</td></tr>
        <tr><td>Selênio</td><td>8,5 mg</td><td>0,03 mg</td></tr>
        <tr><td>Zinco</td><td>1.275 mg</td><td>5,1 mg</td></tr>
        <tr><td>Ferro</td><td>680 mg</td><td>2,72 mg</td></tr>
        <tr><td>EPA + DHA</td><td>2.550 mg</td><td>10,2 mg</td></tr>
      {%- when 'escudo-condroprotetor' -%}
        <tr><td>Glucosamina</td><td>50 g</td><td>200 mg</td></tr>
        <tr><td>Condroitina</td><td>40 g</td><td>160 mg</td></tr>
        <tr><td>Manganês</td><td>1.445 mg</td><td>5,7 mg</td></tr>
        <tr><td>Vitamina E</td><td>2.975 UI</td><td>11,9 UI</td></tr>
        <tr><td>Colágeno tipo II</td><td>42 g</td><td>168 mg</td></tr>
      {%- when 'barreira-anticopro' -%}
        <tr><td>Metionina</td><td>22 g</td><td>88 mg</td></tr>
        <tr><td>Triptofano</td><td>13 g</td><td>52 mg</td></tr>
        <tr><td>Vitamina B6</td><td>397 mg</td><td>1,5 mg</td></tr>
        <tr><td>Beta-glucanos</td><td>6.256 mg</td><td>25 mg</td></tr>
        <tr><td>Lactobacillus acidophilus</td><td>2,55×10⁹ UFC</td><td>1×10⁹ UFC</td></tr>
      {%- when 'neutralizador-de-estresse' -%}
        <tr><td>Glicina</td><td>26 g</td><td>104 mg</td></tr>
        <tr><td>Magnésio</td><td>4.300 mg</td><td>17 mg</td></tr>
        <tr><td>L-teanina</td><td>16.600 mg</td><td>66 mg</td></tr>
        <tr><td>Triptofano</td><td>37 g</td><td>148 mg</td></tr>
        <tr><td>Vitamina B12</td><td>8.000 mcg</td><td>32 mcg</td></tr>
    {%- endcase -%}
  {%- endif -%}
{%- endcapture -%}
{%- assign nutrient_rows_html = nutrient_rows_html | strip -%}

<style>
  #SuppetProductAccordion-{{ uid }} .spa-container {
    max-width: {{ section.settings.content_max_width | default: 900 }}px;
    margin-inline: auto;
  }

  #SuppetProductAccordion-{{ uid }} .spa-accordion {
    border-top: 1px solid rgba(var(--color-scheme-text), 0.12);
  }

  #SuppetProductAccordion-{{ uid }} .spa-item {
    border-bottom: 1px solid rgba(var(--color-scheme-text), 0.12);
  }

  #SuppetProductAccordion-{{ uid }} .spa-item button {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: none;
    border: none;
    padding: 24px 4px;
    font-family: var(--heading-font-stack);
    font-weight: 700;
    font-size: 18px;
    color: rgb(var(--color-scheme-text));
    cursor: pointer;
  }

  #SuppetProductAccordion-{{ uid }} .spa-item button svg {
    width: 20px;
    height: 20px;
    flex: none;
  }

  #SuppetProductAccordion-{{ uid }} .spa-item:not(.is-open) button svg.spa-icon-minus,
  #SuppetProductAccordion-{{ uid }} .spa-item.is-open button svg.spa-icon-plus {
    display: none;
  }

  #SuppetProductAccordion-{{ uid }} .spa-panel {
    display: none;
    padding: 0 4px 26px;
  }

  #SuppetProductAccordion-{{ uid }} .spa-item.is-open .spa-panel {
    display: block;
  }

  #SuppetProductAccordion-{{ uid }} .spa-panel p {
    font-size: 13.5px;
    line-height: 1.7;
    color: rgba(var(--color-scheme-text), 0.68);
  }

  #SuppetProductAccordion-{{ uid }} .spa-panel table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }

  #SuppetProductAccordion-{{ uid }} .spa-panel th {
    text-align: left;
    font-weight: 700;
    font-size: 11.5px;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    color: rgba(var(--color-scheme-text), 0.6);
    padding-bottom: 10px;
    border-bottom: 1px solid rgba(var(--color-scheme-text), 0.12);
  }

  #SuppetProductAccordion-{{ uid }} .spa-panel td {
    padding: 11px 6px;
    border-bottom: 1px dashed rgba(var(--color-scheme-text), 0.12);
  }

  #SuppetProductAccordion-{{ uid }} .spa-panel tr:last-child td {
    border-bottom: none;
  }
</style>

<section id="SuppetProductAccordion-{{ uid }}" class="bg-scheme-background text-scheme-text">
  <div class="section-content px-section py-section-vertical-spacing">
    <div class="spa-container">
      {%- if section.settings.show_guarantee_table or accordion_items.size > 0 -%}
        <div class="spa-accordion">
          {%- if section.settings.show_guarantee_table -%}
            <div class="spa-item is-open">
              <button type="button" data-spa-toggle>
                {{ section.settings.guarantee_title | default: 'Tabela de garantia (níveis mínimos)' }}
                <svg class="spa-icon-plus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                  <path d="M12 5v14M5 12h14"></path>
                </svg>
                <svg class="spa-icon-minus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                  <path d="M5 12h14"></path>
                </svg>
              </button>
              <div class="spa-panel">
                {%- if nutrient_rows_html != blank -%}
                  <table>
                    <thead>
                      <tr>
                        <th>Nutriente</th>
                        <th>Por kg de produto</th>
                        <th>Por unidade (4g)</th>
                      </tr>
                    </thead>
                    <tbody>
                      {{ nutrient_rows_html }}
                    </tbody>
                  </table>
                {%- else -%}
                  <p>{{ section.settings.guarantee_fallback }}</p>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}

          {%- for block in accordion_items -%}
            <div
              class="spa-item{% if forloop.first and section.settings.show_guarantee_table == false %} is-open{% endif %}"
              {{ block.shopify_attributes }}
            >
              <button type="button" data-spa-toggle>
                {{ block.settings.title }}
                <svg class="spa-icon-plus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                  <path d="M12 5v14M5 12h14"></path>
                </svg>
                <svg class="spa-icon-minus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                  <path d="M5 12h14"></path>
                </svg>
              </button>
              <div class="spa-panel">
                <div class="rte">{{ block.settings.content }}</div>
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  (function () {
    function initSuppetProductAccordion(root) {
      if (!root || root.dataset.spaReady === 'true') return;
      root.dataset.spaReady = 'true';

      root.querySelectorAll('[data-spa-toggle]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var item = btn.closest('.spa-item');
          var wasOpen = item.classList.contains('is-open');
          root.querySelectorAll('.spa-item').forEach(function (i) {
            i.classList.remove('is-open');
          });
          if (!wasOpen) item.classList.add('is-open');
        });
      });
    }

    function initAll() {
      Array.prototype.forEach.call(
        document.querySelectorAll('[id^="SuppetProductAccordion-"]'),
        initSuppetProductAccordion
      );
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }

    document.addEventListener('shopify:section:load', function (event) {
      var root = event.target.querySelector('[id^="SuppetProductAccordion-"]');
      if (root) initSuppetProductAccordion(root);
    });
  })();
</script>

{% schema %}
{
  "name": "Suppet product accordion",
  "tag": "section",
  "class": "suppet-product-accordion-section",
  "settings": [
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Largura do conteúdo",
      "min": 600,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 900
    },
    { "type": "header", "content": "Tabela de garantia" },
    {
      "type": "checkbox",
      "id": "show_guarantee_table",
      "label": "Mostrar item \"Tabela de garantia\"",
      "default": true
    },
    {
      "type": "text",
      "id": "guarantee_title",
      "label": "Título",
      "default": "Tabela de garantia (níveis mínimos)"
    },
    {
      "type": "text",
      "id": "guarantee_fallback",
      "label": "Texto quando não houver linhas cadastradas",
      "default": "Consulte a tabela de garantia com os níveis mínimos por quilo de produto e por unidade de 4 g na embalagem do produto."
    }
  ],
  "blocks": [
    {
      "type": "nutrient_row",
      "name": "Linha de garantia",
      "settings": [
        { "type": "text", "id": "nutrient", "label": "Nutriente", "default": "Nutriente" },
        { "type": "text", "id": "per_kg", "label": "Por kg de produto" },
        { "type": "text", "id": "per_unit", "label": "Por unidade (4g)" }
      ]
    },
    {
      "type": "accordion_item",
      "name": "Item do sanfona",
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Título" },
        { "type": "richtext", "id": "content", "label": "Conteúdo" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Suppet product accordion",
      "blocks": [
        {
          "type": "accordion_item",
          "settings": {
            "title": "Modo de uso e conservação",
            "content": "<p>Suplemento super premium mastigável para cães, pronto para consumo. Consulte a recomendação diária de acordo com o peso do pet na embalagem. Conservar em lugar seco, ventilado, ao abrigo dos raios solares e calor excessivo. Após aberto, consumir em até 60 dias.</p>"
          }
        },
        {
          "type": "accordion_item",
          "settings": {
            "title": "Fabricação e SAC",
            "content": "<p>Distribuído por Drogavet Farmácias de Manipulação e Indústria Ltda — Barracão 06, Campo Largo/PR. SAC: <a href=\"tel:+554132098989\">(41) 3209-8989</a> · <a href=\"mailto:sac@drogavet.com.br\">sac@drogavet.com.br</a> · <a href=\"https://www.drogavet.com.br/\" target=\"_blank\" rel=\"noopener noreferrer\">www.drogavet.com.br</a>.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
