{%- comment -%}
  Suppet product hero — porte do ".product-hero" + ".accordion" da LP
  estática (Suppet/produto.html + css/style.css). Usa dados reais do
  produto Shopify (título, descrição, imagem, preço, estoque) — não é
  estático como a LP. Sem animações: troca de estado é instantânea.

  Cards de quantidade (Compre 1 / Compre N com desconto): a porcentagem
  é só exibição, calculada em cima do preço real da variante — quem
  aplica o desconto de verdade no checkout é o desconto automático por
  quantidade já configurado na loja. O card só ajusta a quantidade
  enviada no form de compra pra bater com a condição desse desconto.
{%- endcomment -%}

{%- liquid
  assign uid = section.id
  assign form_id = 'SuppetProductForm-' | append: uid
  assign current_variant = product.selected_or_first_available_variant
  assign mini_benefits = section.blocks | where: 'type', 'mini_benefit'
  assign tagline = product.metafields.custom.tagline | default: section.settings.tagline_fallback

  # Sem blocks de "mini benefício" cadastrados, usa os 4 reais de cada
  # fórmula (mesmos dados da LP de referência), pelo handle do produto —
  # mesma lógica já usada na tabela de garantia e nos petals de "único".
  assign mb_icons = 'paw,heart,leaf,shield' | split: ','
  assign mb_labels = 'Mastigável,Praticidade,Alta palatabilidade,Super premium' | split: ','
  case product.handle
    when 'escudo-condroprotetor'
      assign mb_icons = 'paw,shield,leaf,shield' | split: ','
      assign mb_labels = 'Mastigável,Proteção articular,Alta palatabilidade,Super premium' | split: ','
    when 'barreira-anticopro'
      assign mb_icons = 'paw,bolt,leaf,shield' | split: ','
      assign mb_labels = 'Mastigável,Barreira anticoprofagia,Alta palatabilidade,Super premium' | split: ','
    when 'neutralizador-de-estresse'
      assign mb_icons = 'paw,star,leaf,shield' | split: ','
      assign mb_labels = 'Mastigável,Equilíbrio emocional,Alta palatabilidade,Super premium' | split: ','
  endcase

  assign tier_qty = section.settings.tier_quantity | default: 2
  assign tier_discount = section.settings.tier_discount_percent | default: 10
  assign tier_full_price = current_variant.price | times: tier_qty
  assign tier_discount_amount = tier_full_price | times: tier_discount | divided_by: 100
  assign tier_total_price = tier_full_price | minus: tier_discount_amount

  assign accent_color = section.settings.accent_color
  if product.metafields.custom.accent_color != blank
    assign accent_color = product.metafields.custom.accent_color
  endif

  assign gallery_color = section.settings.gallery_background
  if product.metafields.custom.gallery_color != blank
    assign gallery_color = product.metafields.custom.gallery_color
  elsif product.metafields.custom.accent_color != blank
    assign gallery_color = product.metafields.custom.accent_color
  endif
-%}

<style>
  #SuppetProductHero-{{ uid }} .sph-container {
    max-width: {{ section.settings.content_max_width | default: 1180 }}px;
    margin-inline: auto;
  }

  #SuppetProductHero-{{ uid }} .sph-breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 22px 0;
    font-size: 13px;
    color: rgba(var(--color-scheme-text), 0.6);
  }

  #SuppetProductHero-{{ uid }} .sph-breadcrumb a:hover {
    color: {{ accent_color | default: '#D7282D' }};
  }

  #SuppetProductHero-{{ uid }} .sph-breadcrumb span {
    opacity: 0.5;
  }

  #SuppetProductHero-{{ uid }} .sph-breadcrumb .sph-current {
    color: rgb(var(--color-scheme-text));
    font-weight: 700;
  }

  #SuppetProductHero-{{ uid }} .sph-grid {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: 56px;
    align-items: flex-start;
    padding-bottom: 70px;
  }

  #SuppetProductHero-{{ uid }} .sph-gallery {
    border-radius: 28px;
    overflow: hidden;
    background: {{ gallery_color | default: '#16264A' }};
    padding: 30px;
    text-align: center;
  }

  #SuppetProductHero-{{ uid }} .sph-gallery img {
    width: min(100%, 560px);
    max-width: 560px;
    height: auto;
    margin: 0 auto;
    display: block;
  }

  #SuppetProductHero-{{ uid }} .sph-title {
    font-size: clamp(28px, 3.4vw, 40px);
    font-weight: 800;
    color: {{ accent_color | default: '#D7282D' }};
  }

  #SuppetProductHero-{{ uid }} .sph-tagline {
    display: inline-block;
    margin-top: 14px;
    padding: 8px 16px;
    border-radius: 999px;
    background: {{ accent_color | default: '#D7282D' }};
    color: #fff;
    font-family: var(--heading-font-stack);
    font-weight: 700;
    font-size: 12.5px;
    letter-spacing: 0.3px;
  }

  #SuppetProductHero-{{ uid }} .sph-desc {
    margin-top: 18px;
    max-width: 520px;
    font-size: 15.5px;
    line-height: 1.7;
    color: rgba(var(--color-scheme-text), 0.72);
  }

  #SuppetProductHero-{{ uid }} .sph-package {
    margin-top: 10px;
    font-size: 14px;
    font-weight: 700;
    color: rgb(var(--color-scheme-text));
  }

  #SuppetProductHero-{{ uid }} .sph-note {
    margin-top: 14px;
    font-size: 13px;
    line-height: 1.6;
    color: rgba(var(--color-scheme-text), 0.6);
  }

  #SuppetProductHero-{{ uid }} .sph-rating {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 16px;
  }

  #SuppetProductHero-{{ uid }} .sph-rating .sph-stars {
    color: #f5a623;
    letter-spacing: 2px;
  }

  #SuppetProductHero-{{ uid }} .sph-rating span {
    font-size: 13px;
    font-weight: 600;
    color: rgba(var(--color-scheme-text), 0.6);
  }

  #SuppetProductHero-{{ uid }} .sph-price-app {
    margin-top: 26px;
  }

  #SuppetProductHero-{{ uid }} .sph-tier-list {
    margin-top: 30px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  #SuppetProductHero-{{ uid }} .sph-tier {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 20px;
    border: 2px solid rgba(var(--color-scheme-text), 0.14);
    border-radius: 16px;
    background: transparent;
    text-align: left;
    cursor: pointer;
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  #SuppetProductHero-{{ uid }} .sph-tier:hover {
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    #SuppetProductHero-{{ uid }} .sph-tier {
      transition: none;
    }
  }

  #SuppetProductHero-{{ uid }} .sph-tier.is-active {
    border-color: {{ accent_color | default: '#D7282D' }};
    background: rgba(var(--color-scheme-text), 0.04);
  }

  #SuppetProductHero-{{ uid }} .sph-tier__left {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  #SuppetProductHero-{{ uid }} .sph-tier__radio {
    position: relative;
    width: 22px;
    height: 22px;
    flex: none;
    border-radius: 50%;
    border: 2px solid rgba(var(--color-scheme-text), 0.2);
  }

  #SuppetProductHero-{{ uid }} .sph-tier.is-active .sph-tier__radio {
    border-color: {{ accent_color | default: '#D7282D' }};
  }

  #SuppetProductHero-{{ uid }} .sph-tier.is-active .sph-tier__radio::after {
    content: '';
    position: absolute;
    inset: 4px;
    border-radius: 50%;
    background: {{ accent_color | default: '#D7282D' }};
  }

  #SuppetProductHero-{{ uid }} .sph-tier__name {
    font-family: var(--heading-font-stack);
    font-weight: 700;
    font-size: 16.5px;
    color: rgb(var(--color-scheme-text));
  }

  #SuppetProductHero-{{ uid }} .sph-tier__off {
    display: inline-block;
    margin-left: 8px;
    padding: 3px 9px;
    border-radius: 999px;
    background: {{ accent_color | default: '#D7282D' }};
    color: #fff;
    font-size: 10.5px;
    font-weight: 700;
  }

  #SuppetProductHero-{{ uid }} .sph-tier__save {
    margin-top: 2px;
    font-size: 12.5px;
    color: rgba(var(--color-scheme-text), 0.6);
  }

  #SuppetProductHero-{{ uid }} .sph-tier__price {
    text-align: right;
  }

  #SuppetProductHero-{{ uid }} .sph-tier__price b {
    font-family: var(--heading-font-stack);
    font-size: 21px;
    color: rgb(var(--color-scheme-text));
  }

  #SuppetProductHero-{{ uid }} .sph-tier__unit {
    display: block;
    font-size: 12px;
    color: rgba(var(--color-scheme-text), 0.6);
  }

  #SuppetProductHero-{{ uid }} .sph-buy-row {
    display: flex;
    gap: 14px;
    margin-top: 26px;
    flex-wrap: wrap;
  }

  #SuppetProductHero-{{ uid }} .sph-add-btn {
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 18px 30px;
    border: none;
    border-radius: 999px;
    background: {{ accent_color | default: '#D7282D' }};
    color: #fff;
    font-family: var(--heading-font-stack);
    font-weight: 700;
    font-size: 15px;
    white-space: normal;
    cursor: pointer;
  }

  #SuppetProductHero-{{ uid }} .sph-add-btn:hover {
    filter: brightness(0.92);
  }

  #SuppetProductHero-{{ uid }} .sph-add-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  #SuppetProductHero-{{ uid }} .sph-mini-benefits {
    display: flex;
    gap: 22px;
    margin-top: 34px;
    flex-wrap: wrap;
  }

  #SuppetProductHero-{{ uid }} .sph-mini-benefit {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    width: 78px;
    text-align: center;
  }

  #SuppetProductHero-{{ uid }} .sph-mini-benefit .sph-ic {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: rgba(var(--color-scheme-text), 0.06);
    color: {{ accent_color | default: '#D7282D' }};
    display: grid;
    place-items: center;
  }

  #SuppetProductHero-{{ uid }} .sph-mini-benefit .sph-ic svg {
    width: 24px;
    height: 24px;
  }

  #SuppetProductHero-{{ uid }} .sph-mini-benefit span {
    font-size: 11.5px;
    font-weight: 700;
    line-height: 1.3;
    color: rgba(var(--color-scheme-text), 0.7);
  }

  @media (max-width: 900px) {
    #SuppetProductHero-{{ uid }} .sph-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    #SuppetProductHero-{{ uid }} .sph-gallery {
      padding: 22px;
    }
    #SuppetProductHero-{{ uid }} .sph-buy-row {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>

<section
  id="SuppetProductHero-{{ uid }}"
  class="bg-scheme-background text-scheme-text"
  data-color-scheme="{{ section.settings.color_scheme }}"
>
  <div class="section-content px-section">
    <div class="sph-container">
      <nav class="sph-breadcrumb" aria-label="breadcrumb">
        <a href="{{ routes.root_url }}">Início</a>
        <span>/</span>
        <a href="{{ routes.all_products_collection_url }}">Produtos</a>
        <span>/</span>
        <span class="sph-current">{{ product.title }}</span>
      </nav>

      <div class="sph-grid">
        <div class="sph-gallery">
          {%- if product.featured_image != blank -%}
            {{
              product.featured_image
              | image_url: width: 700
              | image_tag: widths: '350, 500, 700', sizes: '(min-width: 901px) 45vw, 90vw', alt: product.featured_image.alt | default: product.title, loading: 'eager'
            }}
          {%- endif -%}
        </div>

        <div>
          <h1 class="sph-title">{{ product.title }}</h1>

          {%- if tagline != blank -%}
            <span class="sph-tagline">{{ tagline }}</span>
          {%- endif -%}

          {%- if product.description != blank -%}
            <div class="sph-desc rte">{{ product.description }}</div>
          {%- endif -%}

          {%- if section.settings.package_text != blank -%}
            <p class="sph-package">{{ section.settings.package_text }}</p>
          {%- endif -%}

          {%- if section.settings.note_text != blank -%}
            <p class="sph-note">{{ section.settings.note_text }}</p>
          {%- endif -%}

          {%- if section.settings.rating_text != blank -%}
            <div class="sph-rating">
              <span class="sph-stars" aria-hidden="true">★★★★★</span>
              <span>{{ section.settings.rating_text }}</span>
            </div>
          {%- endif -%}

          {%- if current_variant.available -%}
            <div class="sph-tier-list" data-sph-tiers>
              <button type="button" class="sph-tier is-active" data-sph-tier data-qty="1" data-price="{{ current_variant.price }}" aria-pressed="true">
                <div class="sph-tier__left">
                  <span class="sph-tier__radio"></span>
                  <div>
                    <span class="sph-tier__name">Compre 1</span>
                    <div class="sph-tier__save">Preço padrão</div>
                  </div>
                </div>
                <div class="sph-tier__price">
                  <b>{{ current_variant.price | money }}</b>
                  <span class="sph-tier__unit">1 unidade</span>
                </div>
              </button>

              <button type="button" class="sph-tier" data-sph-tier data-qty="{{ tier_qty }}" data-price="{{ tier_total_price }}" aria-pressed="false">
                <div class="sph-tier__left">
                  <span class="sph-tier__radio"></span>
                  <div>
                    <span class="sph-tier__name">
                      Compre {{ tier_qty }}
                      <span class="sph-tier__off">{{ tier_discount }}% OFF</span>
                    </span>
                    <div class="sph-tier__save">Você economiza {{ tier_discount_amount | money }}</div>
                  </div>
                </div>
                <div class="sph-tier__price">
                  <b>{{ tier_total_price | money }}</b>
                  <span class="sph-tier__unit">{{ tier_qty }} unidades</span>
                </div>
              </button>
            </div>
          {%- endif -%}

          {%- comment -%}
            Bloco de app (opcional): se algum dia quiserem reativar um app
            de bundle/desconto, o slot continua aqui. Bloco instalado tem
            type = "shopify://apps/..." no storefront publicado (o literal
            "@app" só existe no schema, como aceite de tipo). Loop direto
            em section.blocks, sem `where` (que quebra a renderização).
          {%- endcomment -%}
          {%- assign has_app_block = false -%}
          {%- for block in section.blocks -%}
            {%- if block.type contains 'shopify://apps' -%}
              {%- assign has_app_block = true -%}
            {%- endif -%}
          {%- endfor -%}

          {%- if has_app_block -%}
            <div class="sph-price-app">
              {%- for block in section.blocks -%}
                {%- if block.type contains 'shopify://apps' -%}
                  {{ block }}
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}

          {% form 'product', product, id: form_id, class: 'sph-form' %}
            <input type="hidden" name="id" value="{{ current_variant.id }}" data-sph-variant-id>
            <input type="hidden" name="quantity" value="1" data-sph-qty-input>
            <div class="sph-buy-row">
              <button
                type="submit"
                class="sph-add-btn"
                {% unless current_variant.available %}disabled{% endunless %}
                data-sph-add-btn
              >
                {%- if current_variant.available -%}
                  Adicionar ao carrinho — <span data-sph-add-price>{{ current_variant.price | money }}</span>
                {%- else -%}
                  Esgotado
                {%- endif -%}
              </button>
            </div>
          {% endform %}

          <div class="sph-mini-benefits">
            {%- if mini_benefits.size > 0 -%}
              {%- for block in mini_benefits -%}
                <div class="sph-mini-benefit" {{ block.shopify_attributes }}>
                  <div class="sph-ic">{%- render 'suppet-icon-mini', icon: block.settings.icon -%}</div>
                  <span>{{ block.settings.label }}</span>
                </div>
              {%- endfor -%}
            {%- else -%}
              {%- for mb_icon in mb_icons -%}
                <div class="sph-mini-benefit">
                  <div class="sph-ic">{%- render 'suppet-icon-mini', icon: mb_icon -%}</div>
                  <span>{{ mb_labels[forloop.index0] }}</span>
                </div>
              {%- endfor -%}
            {%- endif -%}
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  (function () {
    function initSuppetProductHero(root) {
      if (!root || root.dataset.sphReady === 'true') return;
      root.dataset.sphReady = 'true';

      var qtyInput = root.querySelector('[data-sph-qty-input]');
      var addPriceEl = root.querySelector('[data-sph-add-price]');

      function formatMoney(cents) {
        return (cents / 100).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
      }

      root.querySelectorAll('[data-sph-tier]').forEach(function (tier) {
        tier.addEventListener('click', function () {
          root.querySelectorAll('[data-sph-tier]').forEach(function (t) {
            t.classList.remove('is-active');
            t.setAttribute('aria-pressed', 'false');
          });
          tier.classList.add('is-active');
          tier.setAttribute('aria-pressed', 'true');

          if (qtyInput) qtyInput.value = tier.dataset.qty || 1;
          if (addPriceEl) addPriceEl.textContent = formatMoney(parseInt(tier.dataset.price, 10) || 0);
        });
      });

    }

    function initAll() {
      Array.prototype.forEach.call(
        document.querySelectorAll('[id^="SuppetProductHero-"]'),
        initSuppetProductHero
      );
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }

    document.addEventListener('shopify:section:load', function (event) {
      var root = event.target.querySelector('[id^="SuppetProductHero-"]');
      if (root) initSuppetProductHero(root);
    });
  })();
</script>

{% schema %}
{
  "name": "Suppet product hero",
  "tag": "section",
  "class": "suppet-product-hero-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Sem blocos de \"Ícone de benefício\" cadastrados, os 4 mini-benefícios abaixo do preço são preenchidos automaticamente com o conteúdo real de cada uma das 4 fórmulas Suppet (pelo handle do produto). Cadastre blocos aqui só para sobrescrever esse conteúdo."
    },
    {
      "type": "text",
      "id": "tagline_fallback",
      "label": "Selo (se o produto não tiver o metafield custom.tagline)",
      "info": "Cadastre um metafield de produto \"custom.tagline\" (texto de uma linha) pra cada produto ter seu próprio selo. Sem o metafield, usa este texto para todos.",
      "default": "Suplemento Super Premium"
    },
    {
      "type": "text",
      "id": "package_text",
      "label": "Texto da embalagem",
      "default": "Sachê de 150 g (com aproximadamente 34 biscoitos)"
    },
    {
      "type": "text",
      "id": "note_text",
      "label": "Texto pequeno abaixo da descrição",
      "default": "Suplemento mastigável para cães. Em caso de dúvidas, consulte o médico-veterinário."
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Texto ao lado das estrelas",
      "info": "Deixe em branco pra esconder a linha de avaliação.",
      "default": "Suplemento com rotina simples de uso e finalização facilitada pelo WhatsApp"
    },
    { "type": "header", "content": "Card de quantidade" },
    {
      "type": "number",
      "id": "tier_quantity",
      "label": "Quantidade do card com desconto",
      "info": "Precisa bater com a condição do desconto automático configurado na loja.",
      "default": 2
    },
    {
      "type": "number",
      "id": "tier_discount_percent",
      "label": "Desconto do card (%)",
      "info": "Só exibição — quem aplica o desconto de verdade é o desconto automático da loja.",
      "default": 10
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Largura do conteúdo",
      "min": 1000,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1180
    },
    { "type": "header", "content": "Cores" },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Cor de destaque padrão (título, selo, botão, moldura)",
      "info": "Cadastre o metafield de produto \"custom.accent_color\" (cor) pra cada produto ter sua própria cor. Sem o metafield, usa esta cor para todos.",
      "default": "#D7282D"
    },
    {
      "type": "color",
      "id": "gallery_background",
      "label": "Fundo do painel da imagem (fallback)",
      "info": "Usado só se o produto não tiver \"custom.accent_color\" nem \"custom.gallery_color\".",
      "default": "#16264A"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de cores",
      "default": "scheme1"
    }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "mini_benefit",
      "name": "Ícone de benefício",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ícone",
          "options": [
            { "value": "paw", "label": "Pata" },
            { "value": "heart", "label": "Coração" },
            { "value": "leaf", "label": "Folha" },
            { "value": "shield", "label": "Escudo" },
            { "value": "bolt", "label": "Raio" },
            { "value": "star", "label": "Estrela" }
          ],
          "default": "paw"
        },
        { "type": "text", "id": "label", "label": "Texto", "default": "Mastigável" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Suppet product hero"
    }
  ]
}
{% endschema %}
