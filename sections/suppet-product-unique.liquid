{%- comment -%}
  Suppet product unique (petals) — porte do ".unique"/".petals" da LP
  estática (Suppet/produto.html + css/style.css). Usa título e imagem
  reais do produto Shopify. Sem animações — sem hover lift nos petals.
  Arquivo NOVO: não é sobrescrito por atualizações do tema Shapes.
{%- endcomment -%}

{%- liquid
  assign uid = section.id
  assign benefits = section.blocks | where: 'type', 'benefit'
  assign half = benefits.size | divided_by: 2 | ceil
  assign left_benefits = benefits | slice: 0, half
  assign right_benefits = benefits | slice: half, 10

  assign accent_color = section.settings.accent_color
  if product.metafields.custom.accent_color != blank
    assign accent_color = product.metafields.custom.accent_color
  endif
-%}

{%- comment -%}
  Sem blocks cadastrados, usa os 4 benefícios reais de cada fórmula
  (mesmos dados declarados na LP de referência), pelo handle do
  produto — mesma lógica usada na tabela de garantia do sanfona,
  já que os 4 produtos compartilham este mesmo template.
{%- endcomment -%}
{%- unless benefits.size > 0 -%}
  {%- case product.handle -%}
    {%- when 'campo-de-vitaforca' -%}
      {%- assign fb_title_0 = 'Praticidade' -%}
      {%- assign fb_text_0 = 'Biscoito pronto para consumo. Não é em pó e nem precisa misturar, sem complicação na rotina diária.' -%}
      {%- assign fb_title_1 = 'Reforço Imunológico' -%}
      {%- assign fb_text_1 = 'Vitaminas, minerais e aminoácidos essenciais ajudam a fortalecer as defesas naturais do organismo.' -%}
      {%- assign fb_title_2 = 'Alta Palatabilidade' -%}
      {%- assign fb_text_2 = 'Sabor baunilha, aprovado até pelos pets mais exigentes. Parece petisco.' -%}
      {%- assign fb_title_3 = 'Suporte Nutricional' -%}
      {%- assign fb_text_3 = 'Fórmula super premium desenvolvida para complementar a dieta diária de cães adultos.' -%}
    {%- when 'escudo-condroprotetor' -%}
      {%- assign fb_title_0 = 'Proteção Articular' -%}
      {%- assign fb_text_0 = 'A condroitina e a glucosamina atuam na manutenção das articulações.' -%}
      {%- assign fb_title_1 = 'Mastigável' -%}
      {%- assign fb_text_1 = 'Fácil de oferecer e pronto para consumo, sem necessidade de misturar em outros alimentos.' -%}
      {%- assign fb_title_2 = 'Mobilidade e Conforto' -%}
      {%- assign fb_text_2 = 'Contribui para a mobilidade, o conforto e a qualidade de vida em diferentes fases da vida.' -%}
      {%- assign fb_title_3 = 'Praticidade' -%}
      {%- assign fb_text_3 = 'Ideal para uma rotina diária de suplementação simples e consistente.' -%}
    {%- when 'barreira-anticopro' -%}
      {%- assign fb_title_0 = 'Barreira Anticoprofagia' -%}
      {%- assign fb_text_0 = 'Ajuda a reduzir o hábito de ingestão das fezes e contribui para o bem-estar do cão.' -%}
      {%- assign fb_title_1 = 'Equilíbrio Intestinal' -%}
      {%- assign fb_text_1 = 'Os prebióticos e os probióticos favorecem uma microbiota intestinal saudável.' -%}
      {%- assign fb_title_2 = 'Mastigável' -%}
      {%- assign fb_text_2 = 'Formato prático, fácil de oferecer e adequado para a rotina diária.' -%}
      {%- assign fb_title_3 = 'Bem-Estar Digestivo' -%}
      {%- assign fb_text_3 = 'Contribui para uma digestão mais equilibrada e para o melhor aproveitamento dos nutrientes.' -%}
    {%- when 'neutralizador-de-estresse' -%}
      {%- assign fb_title_0 = 'Equilíbrio Emocional' -%}
      {%- assign fb_text_0 = 'O L-triptofano e a L-teanina ajudam a promover calma e equilíbrio.' -%}
      {%- assign fb_title_1 = 'Bem-Estar' -%}
      {%- assign fb_text_1 = 'Auxilia em momentos de tensão, viagens, fogos ou mudanças de rotina.' -%}
      {%- assign fb_title_2 = 'Mastigável' -%}
      {%- assign fb_text_2 = 'Sabor maracujá e formato prático para oferecer no dia a dia.' -%}
      {%- assign fb_title_3 = 'Consumo Flexível' -%}
      {%- assign fb_text_3 = 'Pode integrar a rotina sempre que o cão precisar de mais tranquilidade.' -%}
  {%- endcase -%}
{%- endunless -%}

<style>
  #SuppetProductUnique-{{ uid }} {
    background: {{ section.settings.background_color | default: '#ffffff' }};
  }

  #SuppetProductUnique-{{ uid }} .spu-container {
    max-width: {{ section.settings.content_max_width | default: 1180 }}px;
    margin-inline: auto;
  }

  #SuppetProductUnique-{{ uid }} .spu-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-align: center;
    margin-bottom: 48px;
  }

  #SuppetProductUnique-{{ uid }} .spu-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--heading-font-stack);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: {{ accent_color | default: '#D7282D' }};
  }

  #SuppetProductUnique-{{ uid }} .spu-eyebrow::before {
    content: '';
    width: 22px;
    height: 3px;
    border-radius: 3px;
    background: currentColor;
  }

  #SuppetProductUnique-{{ uid }} .spu-title {
    font-size: clamp(26px, 3.6vw, 40px);
    font-weight: 800;
  }

  #SuppetProductUnique-{{ uid }} .spu-petals {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 26px;
    align-items: center;
    max-width: 1080px;
    margin: 0 auto;
  }

  #SuppetProductUnique-{{ uid }} .spu-col {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  #SuppetProductUnique-{{ uid }} .spu-petal {
    border-radius: 28px;
    padding: 22px 26px;
    color: #fff;
    background: {{ accent_color | default: '#D7282D' }};
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  #SuppetProductUnique-{{ uid }} .spu-petal:hover {
    transform: translateY(-6px) scale(1.02);
  }

  @media (prefers-reduced-motion: reduce) {
    #SuppetProductUnique-{{ uid }} .spu-petal {
      transition: none;
    }
  }

  #SuppetProductUnique-{{ uid }} .spu-petal.is-dark {
    /* Sobrepõe um véu escuro só no fundo (não usa filter no elemento
       inteiro) — isso escurecia o texto branco junto com o fundo e
       derrubava o contraste do parágrafo. */
    background: linear-gradient(rgba(0, 0, 0, 0.32), rgba(0, 0, 0, 0.32)), {{ accent_color | default: '#D7282D' }};
  }

  #SuppetProductUnique-{{ uid }} .spu-col:first-child .spu-petal {
    border-top-right-radius: 70px;
    border-bottom-right-radius: 70px;
  }

  #SuppetProductUnique-{{ uid }} .spu-col:last-child .spu-petal {
    border-top-left-radius: 70px;
    border-bottom-left-radius: 70px;
  }

  #SuppetProductUnique-{{ uid }} .spu-petal h4 {
    font-family: var(--heading-font-stack);
    font-size: 16px;
    font-weight: 700;
    margin-bottom: 8px;
  }

  #SuppetProductUnique-{{ uid }} .spu-petal p {
    font-size: 13px;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.96);
  }

  #SuppetProductUnique-{{ uid }} .spu-center {
    display: flex;
    justify-content: center;
  }

  #SuppetProductUnique-{{ uid }} .spu-center img {
    max-width: 380px;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 30px 50px rgba(16, 35, 66, 0.25));
  }

  @media (max-width: 900px) {
    #SuppetProductUnique-{{ uid }} .spu-center img {
      max-width: 300px;
    }
  }

  @media (max-width: 860px) {
    #SuppetProductUnique-{{ uid }} .spu-petals {
      grid-template-columns: 1fr;
    }
    #SuppetProductUnique-{{ uid }} .spu-center {
      order: -1;
      margin-bottom: 10px;
    }
    #SuppetProductUnique-{{ uid }} .spu-col:first-child .spu-petal,
    #SuppetProductUnique-{{ uid }} .spu-col:last-child .spu-petal {
      border-radius: 24px;
    }
  }
</style>

<section id="SuppetProductUnique-{{ uid }}">
  <div class="section-content px-section py-section-vertical-spacing">
    <div class="spu-container">
      <div class="spu-head">
        <p class="spu-eyebrow">{{ product.title | default: 'Suppet' }}</p>
        <h2 class="spu-title">
          {{ section.settings.title_prefix | default: 'O que torna' }}
          {{ product.title }}
          {{ section.settings.title_suffix | default: 'único?' }}
        </h2>
      </div>

      {%- if benefits.size > 0 or fb_title_0 != blank -%}
        {%- capture spu_center -%}
          <div class="spu-center">
            {%- if product.featured_image != blank -%}
              {{
                product.featured_image
                | image_url: width: 500
                | image_tag: widths: '250, 350, 500', sizes: '380px', alt: product.title, loading: 'lazy'
              }}
            {%- endif -%}
          </div>
        {%- endcapture -%}
        <div class="spu-petals">
          {%- if benefits.size > 0 -%}
            <div class="spu-col">
              {%- for block in left_benefits -%}
                <div class="spu-petal{% if forloop.index0 == 1 %} is-dark{% endif %}" {{ block.shopify_attributes }}>
                  <h4>{{ block.settings.title }}</h4>
                  <p>{{ block.settings.text }}</p>
                </div>
              {%- endfor -%}
            </div>

            {{ spu_center }}

            <div class="spu-col">
              {%- for block in right_benefits -%}
                <div class="spu-petal{% if forloop.index0 == 0 %} is-dark{% endif %}" {{ block.shopify_attributes }}>
                  <h4>{{ block.settings.title }}</h4>
                  <p>{{ block.settings.text }}</p>
                </div>
              {%- endfor -%}
            </div>
          {%- else -%}
            <div class="spu-col">
              <div class="spu-petal"><h4>{{ fb_title_0 }}</h4><p>{{ fb_text_0 }}</p></div>
              <div class="spu-petal is-dark"><h4>{{ fb_title_1 }}</h4><p>{{ fb_text_1 }}</p></div>
            </div>

            {{ spu_center }}

            <div class="spu-col">
              <div class="spu-petal is-dark"><h4>{{ fb_title_2 }}</h4><p>{{ fb_text_2 }}</p></div>
              <div class="spu-petal"><h4>{{ fb_title_3 }}</h4><p>{{ fb_text_3 }}</p></div>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Suppet product unique",
  "tag": "section",
  "class": "suppet-product-unique-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Sem blocos de \"Benefício\" cadastrados, os 4 pontos são preenchidos automaticamente com o conteúdo real de cada uma das 4 fórmulas Suppet (pelo handle do produto). Cadastre blocos aqui só para sobrescrever esse conteúdo."
    },
    {
      "type": "text",
      "id": "title_prefix",
      "label": "Título (antes do nome do produto)",
      "default": "O que torna"
    },
    {
      "type": "text",
      "id": "title_suffix",
      "label": "Título (depois do nome do produto)",
      "default": "único?"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Largura do conteúdo",
      "min": 1000,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1180
    },
    { "type": "header", "content": "Cores" },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Cor padrão dos petals",
      "info": "Usa o metafield de produto \"custom.accent_color\" quando existir (mesmo do topo da página).",
      "default": "#D7282D"
    },
    { "type": "color", "id": "background_color", "label": "Fundo da seção", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefício",
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Benefício" },
        { "type": "textarea", "id": "text", "label": "Texto" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Suppet product unique"
    }
  ]
}
{% endschema %}
