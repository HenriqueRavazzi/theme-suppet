<script>
(function(){
  try{
    var root = document.getElementById('SuppetPolicyStatic-{{ uid }}');
    var body = root.querySelector('[data-sp-body]');
    var headings = body.querySelectorAll('h2');
    if (headings.length < 2) return;

    var desktop = root.querySelector('[data-sp-toc-desktop]');
    var mobile = root.querySelector('[data-sp-toc-mobile]');
    var listDesktop = root.querySelector('[data-sp-toc-list]');
    var listMobile = root.querySelector('[data-sp-toc-list-mobile]');
    desktop.hidden = false;
    mobile.hidden = false;
    mobile.setAttribute('data-has-toc', '');

    var links = [];
    headings.forEach(function(h, i){
      var id = 'sp-section-{{ uid }}-' + (i + 1);
      h.id = id;
      var text = h.textContent;
      [listDesktop, listMobile].forEach(function(list){
        var li = document.createElement('li');
        var a = document.createElement('a');
        a.href = '#' + id;
        a.dataset.target = id;
        a.textContent = text;
        li.appendChild(a);
        list.appendChild(li);
        if (list === listDesktop) links.push(a);
      });
    });

    if ('IntersectionObserver' in window){
      var observer = new IntersectionObserver(function(entries){
        entries.forEach(function(entry){
          if (entry.isIntersecting){
            links.forEach(function(l){ l.classList.remove('active'); });
            var active = listDesktop.querySelector('a[data-target="' + entry.target.id + '"]');
            if (active) active.classList.add('active');
          }
        });
      }, { rootMargin: '-20% 0px -70% 0px' });
      headings.forEach(function(h){ observer.observe(h); });
    }
  } catch(e){}
})();
</script>

