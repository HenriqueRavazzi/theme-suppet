{%- comment -%}
  Suppet campaign (Ative o super do seu pet) — porte estático do bloco
  ".campaign"/".campaign-carousel" da LP (Suppet/index.html + css/style.css,
  seção id="campanha"). Sem carrossel/rotação: mostra só um produto fixo.
  Arquivo NOVO: não é sobrescrito por atualizações do tema Shapes.
{%- endcomment -%}

{%- liquid
  assign uid = section.id
  assign list_items = section.blocks | where: 'type', 'list_item'
  assign badges = section.blocks | where: 'type', 'badge'
  assign product_slides = section.blocks | where: 'type', 'product_slide'
  assign motion = section.settings.enable_motion
-%}

<style>
  #SuppetCampaign-{{ uid }} .sc-container {
    max-width: {{ section.settings.content_max_width | default: 1240 }}px;
    margin-inline: auto;
  }

  #SuppetCampaign-{{ uid }} .sc-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  #SuppetCampaign-{{ uid }} .sc-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--heading-font-stack);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: {{ section.settings.brand_color | default: '#D7282D' }};
  }

  #SuppetCampaign-{{ uid }} .sc-eyebrow::before {
    content: '';
    width: 22px;
    height: 3px;
    border-radius: 3px;
    background: currentColor;
  }

  #SuppetCampaign-{{ uid }} .sc-title {
    margin-top: 12px;
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 800;
    line-height: 1.1;
  }

  #SuppetCampaign-{{ uid }} .sc-lead {
    margin-top: 18px;
    font-size: 17px;
    line-height: 1.7;
    color: rgba(var(--color-scheme-text), 0.7);
  }

  #SuppetCampaign-{{ uid }} .sc-list {
    margin-top: 26px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  #SuppetCampaign-{{ uid }} .sc-list li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-size: 14.5px;
    font-weight: 600;
  }

  #SuppetCampaign-{{ uid }} .sc-list svg {
    flex: none;
    width: 22px;
    height: 22px;
    margin-top: 1px;
    color: {{ section.settings.brand_color | default: '#D7282D' }};
  }

  #SuppetCampaign-{{ uid }} .sc-cta {
    margin-top: 32px;
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  #SuppetCampaign-{{ uid }} .sc-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 30px;
    border-radius: 999px;
    font-family: var(--heading-font-stack);
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.3px;
    white-space: nowrap;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  #SuppetCampaign-{{ uid }} .sc-btn:active {
    transform: scale(0.97);
  }

  #SuppetCampaign-{{ uid }} .sc-btn-primary {
    background: {{ section.settings.brand_color | default: '#D7282D' }};
    color: #fff;
    box-shadow: 0 10px 24px -8px rgba(215, 40, 45, 0.55);
  }

  #SuppetCampaign-{{ uid }} .sc-btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 30px -8px rgba(215, 40, 45, 0.6);
  }

  #SuppetCampaign-{{ uid }} .sc-btn-navy {
    background: #0e1b33;
    color: #fff;
  }

  #SuppetCampaign-{{ uid }} .sc-btn-navy:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 26px -10px rgba(14, 27, 51, 0.5);
  }

  #SuppetCampaign-{{ uid }} .sc-art {
    position: relative;
  }

  #SuppetCampaign-{{ uid }} .sc-panel {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: 32px;
    /* Altura final da LP (AJUSTE FINAL — CENTRALIZAÇÃO VERTICAL DO BLOCO). */
    min-height: 700px;
    background: linear-gradient(145deg, #10213f 0%, #0e1b33 58%, #172b4e 100%);
    box-shadow: 0 40px 70px -30px rgba(16, 35, 66, 0.5);
  }

  #SuppetCampaign-{{ uid }} .sc-slide {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    padding: 40px 42px 34px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(18px) scale(0.98);
    transition: opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0.6s;
  }

  #SuppetCampaign-{{ uid }} .sc-slide.is-active {
    z-index: 2;
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    #SuppetCampaign-{{ uid }} .sc-slide {
      transition: opacity 0.3s linear, visibility 0.3s;
      transform: none;
    }
  }

  #SuppetCampaign-{{ uid }} .sc-rays {
    position: absolute;
    inset: -30%;
    z-index: 0;
    opacity: 0.28;
    background: repeating-conic-gradient(from 0deg at 50% 40%, rgba(255, 255, 255, 0.28) 0deg 4deg, transparent 4deg 15deg);
    -webkit-mask-image: radial-gradient(circle at 50% 40%, #000 0%, transparent 55%);
    mask-image: radial-gradient(circle at 50% 40%, #000 0%, transparent 55%);
    pointer-events: none;
  }

  #SuppetCampaign-{{ uid }} .sc-glow {
    position: absolute;
    inset: -15%;
    z-index: 0;
    background: radial-gradient(circle at 50% 38%, var(--sc-accent, #dd6e1f55), transparent 62%);
    transition: background 0.6s ease;
    pointer-events: none;
  }

  #SuppetCampaign-{{ uid }} .sc-media {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 0;
  }

  #SuppetCampaign-{{ uid }} .sc-media img {
    /* Precisa preencher 100% de largura E altura (não só max-height) —
       sem isso, a caixa da imagem virava "auto" no eixo vertical e podia
       crescer mais que o espaço que o flex reservou pra ela, empurrando
       a legenda pra fora do card em telas menores. */
    width: 100%;
    height: 100%;
    max-width: 350px;
    object-fit: contain;
    filter: drop-shadow(0 28px 28px rgba(0, 0, 0, 0.34));
  }

  #SuppetCampaign-{{ uid }} .sc-caption {
    position: relative;
    z-index: 1;
    color: #fff;
  }

  #SuppetCampaign-{{ uid }} .sc-caption .sc-tag {
    display: inline-flex;
    padding: 7px 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.13);
    font-family: var(--heading-font-stack);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.1px;
    text-transform: uppercase;
  }

  #SuppetCampaign-{{ uid }} .sc-caption a {
    color: inherit;
    text-decoration: none;
  }

  #SuppetCampaign-{{ uid }} .sc-caption strong {
    display: block;
    max-width: 340px;
    margin-top: 14px;
    font-family: var(--heading-font-stack);
    font-size: clamp(24px, 2.4vw, 36px);
    line-height: 1.05;
  }

  #SuppetCampaign-{{ uid }} .sc-caption small {
    display: block;
    margin-top: 10px;
    font-size: 14px;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.7);
  }

  #SuppetCampaign-{{ uid }} .sc-arrow {
    position: absolute;
    z-index: 8;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: rgba(14, 27, 51, 0.62);
    color: #fff;
    display: grid;
    place-items: center;
    backdrop-filter: blur(8px);
    transition: background 0.25s ease, color 0.25s ease, transform 0.25s ease;
  }

  #SuppetCampaign-{{ uid }} .sc-arrow:hover {
    background: #fff;
    color: #0e1b33;
    transform: translateY(-50%) scale(1.07);
  }

  #SuppetCampaign-{{ uid }} .sc-arrow svg {
    width: 18px;
    height: 18px;
  }

  #SuppetCampaign-{{ uid }} .sc-arrow--prev {
    left: 14px;
  }

  #SuppetCampaign-{{ uid }} .sc-arrow--next {
    right: 14px;
  }

  #SuppetCampaign-{{ uid }} .sc-dots {
    position: absolute;
    z-index: 8;
    left: 50%;
    bottom: 18px;
    transform: translateX(-50%);
    display: flex;
    gap: 8px;
    padding: 7px 9px;
    border-radius: 999px;
    background: rgba(7, 16, 31, 0.36);
    backdrop-filter: blur(8px);
  }

  #SuppetCampaign-{{ uid }} .sc-dots button {
    width: 8px;
    height: 8px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.35);
    transition: width 0.3s ease, background 0.3s ease;
  }

  #SuppetCampaign-{{ uid }} .sc-dots button[aria-current='true'] {
    width: 24px;
    background: #fff;
  }

  #SuppetCampaign-{{ uid }} .sc-badges {
    position: absolute;
    z-index: 2;
    top: 20px;
    right: -18px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  #SuppetCampaign-{{ uid }} .sc-badges span {
    background: #0e1b33;
    color: #fff;
    font-family: var(--heading-font-stack);
    font-weight: 700;
    font-size: 12px;
    padding: 10px 16px;
    border-radius: 999px;
    box-shadow: 0 14px 26px -12px rgba(0, 0, 0, 0.4);
    animation: sc-floaty 5s ease-in-out infinite;
  }

  #SuppetCampaign-{{ uid }} .sc-badges span:nth-child(2) {
    animation-delay: 0.6s;
  }

  #SuppetCampaign-{{ uid }} .sc-badges span:nth-child(3) {
    animation-delay: 1.2s;
  }

  @keyframes sc-floaty {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #SuppetCampaign-{{ uid }} .sc-badges span {
      animation: none;
    }
  }

  @media (max-width: 940px) {
    #SuppetCampaign-{{ uid }} .sc-grid {
      grid-template-columns: 1fr;
    }
    #SuppetCampaign-{{ uid }} .sc-art {
      order: -1;
    }
    #SuppetCampaign-{{ uid }} .sc-badges {
      right: 6px;
    }
    #SuppetCampaign-{{ uid }} .sc-panel {
      min-height: 620px;
    }
    #SuppetCampaign-{{ uid }} .sc-media img {
      max-width: 300px;
      max-height: 400px;
    }
  }

  @media (max-width: 520px) {
    #SuppetCampaign-{{ uid }} .sc-panel {
      min-height: 480px;
    }
    #SuppetCampaign-{{ uid }} .sc-slide {
      padding: 32px 26px 28px;
    }
    #SuppetCampaign-{{ uid }} .sc-media img {
      max-width: 240px;
      max-height: 320px;
    }
    #SuppetCampaign-{{ uid }} .sc-arrow {
      width: 36px;
      height: 36px;
    }
  }
</style>

<section
  id="SuppetCampaign-{{ uid }}"
  class="bg-scheme-background text-scheme-text {% if section.settings.use_gradient_background %}bg-scheme-gradient{% endif %}"
  data-color-scheme="{{ section.settings.color_scheme }}"
>
  <span id="campanha" class="visually-hidden" tabindex="-1"></span>
  <div class="section-content px-section py-section-vertical-spacing">
    <div class="sc-container">
      <div class="sc-grid">
        <div>
          {%- if section.settings.eyebrow != blank -%}
            <p class="sc-eyebrow">{{ section.settings.eyebrow }}</p>
          {%- endif -%}

          {%- if section.settings.title != blank -%}
            <h2 class="sc-title inline-heading-rte font-heading break-words">{{ section.settings.title }}</h2>
          {%- endif -%}

          {%- if section.settings.richtext != blank -%}
            <div class="sc-lead rte font-main">{{ section.settings.richtext }}</div>
          {%- endif -%}

          {%- if list_items.size > 0 -%}
            <ul class="sc-list">
              {%- for block in list_items -%}
                <li {{ block.shopify_attributes }}>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 6L9 17l-5-5"></path>
                  </svg>
                  <span>{{ block.settings.text }}</span>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}

          {%- if section.settings.cta_primary_label != blank or section.settings.cta_secondary_label != blank -%}
            <div class="sc-cta">
              {%- if section.settings.cta_primary_label != blank -%}
                <a href="{{ section.settings.cta_primary_url | default: '#' }}" class="sc-btn sc-btn-primary">
                  {{- section.settings.cta_primary_label -}}
                </a>
              {%- endif -%}
              {%- if section.settings.cta_secondary_label != blank -%}
                <a href="{{ section.settings.cta_secondary_url | default: '#' }}" class="sc-btn sc-btn-navy">
                  {{- section.settings.cta_secondary_label -}}
                </a>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>

        <div
          class="sc-art"
          data-suppet-campaign-carousel
          data-motion="{{ motion }}"
          data-autoplay="{{ section.settings.autoplay }}"
          data-speed="{{ section.settings.speed }}"
        >
          <div class="sc-panel">
            <div class="sc-glow" data-sc-glow></div>

            {%- for block in product_slides -%}
              {%- liquid
                assign p = all_products[block.settings.product]
                assign slide_link = p.url | default: block.settings.link
                assign slide_name = p.title | default: block.settings.name
                assign slide_accent = block.settings.accent | default: '#DD6E1F'

                assign fallback_asset = 'campaign-condroprotetor.webp'
                case block.settings.product
                  when 'campo-de-vitaforca'
                    assign fallback_asset = 'campaign-vitaforca.webp'
                  when 'escudo-condroprotetor'
                    assign fallback_asset = 'campaign-condroprotetor.webp'
                  when 'barreira-anticopro'
                    assign fallback_asset = 'campaign-anticopro.webp'
                  when 'neutralizador-de-estresse'
                    assign fallback_asset = 'campaign-estresse.webp'
                endcase

                assign loading_attr = 'lazy'
                if forloop.first
                  assign loading_attr = 'eager'
                endif
              -%}
              <div
                class="sc-slide{% if forloop.first %} is-active{% endif %}"
                data-sc-slide
                data-accent="{{ slide_accent }}"
                {% unless forloop.first %}aria-hidden="true"{% endunless %}
                {{ block.shopify_attributes }}
              >
                <div class="sc-rays"></div>

                <div class="sc-media">
                  {%- if block.settings.image != blank -%}
                    {{
                      block.settings.image
                      | image_url: width: 600
                      | image_tag: widths: '300, 450, 600', sizes: '300px', alt: slide_name, loading: loading_attr
                    }}
                  {%- else -%}
                    <img
                      src="{{ fallback_asset | asset_url }}"
                      alt="{{ slide_name | default: 'Suppet' }}"
                      loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                      width="1422"
                      height="1957"
                    >
                  {%- endif -%}
                </div>

                <div class="sc-caption">
                  {%- if block.settings.tag != blank -%}
                    <span class="sc-tag">{{ block.settings.tag }}</span>
                  {%- endif -%}
                  {%- if slide_link != blank -%}
                    <a href="{{ slide_link }}">
                      {%- if slide_name != blank -%}<strong>{{ slide_name }}</strong>{%- endif -%}
                    </a>
                  {%- elsif slide_name != blank -%}
                    <strong>{{ slide_name }}</strong>
                  {%- endif -%}
                  {%- if block.settings.subtitle != blank -%}
                    <small>{{ block.settings.subtitle }}</small>
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}

            {%- if motion and product_slides.size > 1 -%}
              <button type="button" class="sc-arrow sc-arrow--prev" data-sc-prev aria-label="Produto anterior">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M15 5l-7 7 7 7"></path>
                </svg>
              </button>
              <button type="button" class="sc-arrow sc-arrow--next" data-sc-next aria-label="Próximo produto">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M9 5l7 7-7 7"></path>
                </svg>
              </button>
              <div class="sc-dots" data-sc-dots aria-label="Selecionar produto">
                {%- for block in product_slides -%}
                  {%- assign dot_name = all_products[block.settings.product].title | default: block.settings.name -%}
                  <button
                    type="button"
                    data-sc-dot
                    data-index="{{ forloop.index0 }}"
                    aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                    aria-label="{{ dot_name | escape }}"
                  ></button>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>

          {%- if badges.size > 0 -%}
            <div class="sc-badges">
              {%- for block in badges -%}
                <span {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    function initSuppetCampaignCarousel(root) {
      if (!root || root.dataset.scReady === 'true') return;
      root.dataset.scReady = 'true';

      if (root.dataset.motion === 'false') return;

      var slides = Array.prototype.slice.call(root.querySelectorAll('[data-sc-slide]'));
      if (slides.length < 2) return;

      var glow = root.querySelector('[data-sc-glow]');
      var dots = Array.prototype.slice.call(root.querySelectorAll('[data-sc-dot]'));
      var prev = root.querySelector('[data-sc-prev]');
      var next = root.querySelector('[data-sc-next]');
      var speed = parseInt(root.dataset.speed, 10) || 3400;
      var autoplay = root.dataset.autoplay === 'true';
      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var current = 0;
      var timer = null;

      function goTo(index) {
        slides[current].classList.remove('is-active');
        slides[current].setAttribute('aria-hidden', 'true');
        if (dots[current]) dots[current].setAttribute('aria-current', 'false');

        current = ((index % slides.length) + slides.length) % slides.length;

        slides[current].classList.add('is-active');
        slides[current].removeAttribute('aria-hidden');
        if (dots[current]) dots[current].setAttribute('aria-current', 'true');

        var accent = slides[current].dataset.accent;
        if (glow && accent) glow.style.setProperty('--sc-accent', accent + '55');
      }

      function stop() {
        if (timer) {
          clearInterval(timer);
          timer = null;
        }
      }

      function start() {
        stop();
        if (!autoplay || reduced) return;
        timer = setInterval(function () {
          goTo(current + 1);
        }, speed);
      }

      if (prev) {
        prev.addEventListener('click', function () {
          goTo(current - 1);
          start();
        });
      }
      if (next) {
        next.addEventListener('click', function () {
          goTo(current + 1);
          start();
        });
      }
      dots.forEach(function (dot) {
        dot.addEventListener('click', function () {
          goTo(parseInt(dot.dataset.index, 10));
          start();
        });
      });

      root.addEventListener('mouseenter', stop);
      root.addEventListener('mouseleave', start);
      root.addEventListener('focusin', stop);
      root.addEventListener('focusout', start);

      document.addEventListener('visibilitychange', function () {
        if (document.hidden) stop();
        else start();
      });

      goTo(0);
      start();
    }

    function initAll() {
      Array.prototype.forEach.call(
        document.querySelectorAll('[data-suppet-campaign-carousel]'),
        initSuppetCampaignCarousel
      );
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }

    document.addEventListener('shopify:section:load', function (event) {
      var root = event.target.querySelector('[data-suppet-campaign-carousel]');
      if (root) initSuppetCampaignCarousel(root);
    });
  })();
</script>

{% schema %}
{
  "name": "Suppet campaign",
  "tag": "section",
  "class": "suppet-campaign-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Campanha Suppet"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Título",
      "default": "Ative o super do seu pet"
    },
    {
      "type": "richtext",
      "id": "richtext",
      "label": "Texto",
      "default": "<p>Coloque no carrinho e compre facilmente.</p>"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Largura do conteúdo",
      "min": 1100,
      "max": 1820,
      "step": 20,
      "unit": "px",
      "default": 1240
    },
    { "type": "header", "content": "Botões" },
    {
      "type": "text",
      "id": "cta_primary_label",
      "label": "Botão principal",
      "default": "Ver todos os produtos"
    },
    { "type": "url", "id": "cta_primary_url", "label": "Link do botão principal" },
    {
      "type": "text",
      "id": "cta_secondary_label",
      "label": "Botão secundário",
      "default": "Fale com a gente"
    },
    { "type": "url", "id": "cta_secondary_url", "label": "Link do botão secundário" },
    { "type": "header", "content": "Carrossel de produtos" },
    {
      "type": "checkbox",
      "id": "enable_motion",
      "label": "Ativar carrossel (setas, bolinhas e troca automática)",
      "info": "Desligado, mostra só o primeiro produto cadastrado, fixo.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Trocar produto automaticamente",
      "default": true
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Intervalo entre trocas",
      "min": 2000,
      "max": 8000,
      "step": 200,
      "unit": "ms",
      "default": 3400
    },
    { "type": "header", "content": "Cores" },
    {
      "type": "color",
      "id": "brand_color",
      "label": "Cor da marca (eyebrow, checklist, botão principal)",
      "default": "#D7282D"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de cores",
      "default": "scheme2"
    },
    {
