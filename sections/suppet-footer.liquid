{%- comment -%}
  Suppet footer — porte do ".site-footer" da LP estática
  (Suppet/index.html + css/style.css). Fundo navy, 4 colunas
  (marca+redes sociais, Institucional, Ajuda, Contato) + barra inferior.
  Arquivo NOVO: não é sobrescrito por atualizações do tema Shapes.
{%- endcomment -%}

{%- liquid
  assign uid = section.id
  comment
    where: 'settings.column' não funciona em settings aninhados de blocks —
    as colunas sumiam. Contamos e filtramos no loop.
  endcomment
  assign has_institutional = false
  assign has_help = false
  assign has_contact = false
  for block in section.blocks
    if block.type == 'link'
      case block.settings.column
        when 'institutional'
          assign has_institutional = true
        when 'help'
          assign has_help = true
        when 'contact'
          assign has_contact = true
      endcase
    endif
  endfor
-%}

<style>
  #SuppetFooter-{{ uid }} {
    background: {{ section.settings.background_color | default: '#0E1B33' }};
    color: rgba(255, 255, 255, 0.7);
    padding-top: 72px;
  }

  #SuppetFooter-{{ uid }} .sf-container {
    max-width: {{ section.settings.content_max_width | default: 1240 }}px;
    margin-inline: auto;
  }

  #SuppetFooter-{{ uid }} .sf-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.2fr;
    gap: 40px;
    padding-bottom: 50px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  #SuppetFooter-{{ uid }} .sf-logo {
    height: 28px;
    width: auto;
    margin-bottom: 16px;
  }

  #SuppetFooter-{{ uid }} .sf-tagline {
    font-size: 13.5px;
    line-height: 1.7;
    max-width: 280px;
  }

  #SuppetFooter-{{ uid }} .sf-social {
    display: flex;
    gap: 10px;
    margin-top: 16px;
  }

  #SuppetFooter-{{ uid }} .sf-social a {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    display: grid;
    place-items: center;
    color: #fff;
    transition: background 0.3s ease, transform 0.3s ease;
  }

  #SuppetFooter-{{ uid }} .sf-social a svg {
    width: 18px;
    height: 18px;
  }

  #SuppetFooter-{{ uid }} .sf-social a:hover {
    background: {{ section.settings.accent_color | default: '#D7282D' }};
    transform: translateY(-3px);
  }

  #SuppetFooter-{{ uid }} .sf-col h5 {
    color: #fff;
    font-family: var(--heading-font-stack);
    font-size: 14.5px;
    letter-spacing: 0.3px;
    margin-bottom: 18px;
  }

  #SuppetFooter-{{ uid }} .sf-col ul {
    display: flex;
    flex-direction: column;
    gap: 11px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  #SuppetFooter-{{ uid }} .sf-col a,
  #SuppetFooter-{{ uid }} .sf-col span {
    font-size: 13.5px;
    color: rgba(255, 255, 255, 0.7);
    transition: color 0.25s ease, padding-left 0.25s ease;
  }

  #SuppetFooter-{{ uid }} .sf-col a:hover {
    color: #fff;
    padding-left: 4px;
  }

  #SuppetFooter-{{ uid }} .sf-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    padding: 24px 0;
    font-size: 12.5px;
  }

  @media (max-width: 880px) {
    #SuppetFooter-{{ uid }} .sf-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 520px) {
    #SuppetFooter-{{ uid }} .sf-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<footer id="SuppetFooter-{{ uid }}">
  <span id="contato" class="visually-hidden" tabindex="-1"></span>
  <div class="section-content px-section">
    <div class="sf-container">
      <div class="sf-grid">
        <div class="sf-col">
          {%- if section.settings.logo != blank -%}
            {{ section.settings.logo | image_url: width: 300 | image_tag: class: 'sf-logo', alt: 'DrogaVET' }}
          {%- else -%}
            <img
              class="sf-logo"
              src="{{ 'logo_white.png' | asset_url }}"
              alt="DrogaVET"
              loading="lazy"
              width="2400"
              height="560"
            >
          {%- endif -%}
          {%- if section.settings.tagline != blank -%}
            <p class="sf-tagline">{{ section.settings.tagline }}</p>
          {%- endif -%}
          <div class="sf-social">
            {%- if section.settings.instagram_url != blank -%}
              <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect>
                  <circle cx="12" cy="12" r="4"></circle>
                  <circle cx="17" cy="7" r="1"></circle>
                </svg>
              </a>
            {%- endif -%}
            {%- if section.settings.facebook_url != blank -%}
              <a href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path d="M14 22v-8h2.7l.4-3.2H14V8.7c0-.9.3-1.6 1.7-1.6h1.8V4.2C17.2 4.1 16 4 14.7 4 11.9 4 10 5.7 10 8.4v2.4H7.3v3.2H10V22h4Z"></path>
                </svg>
              </a>
            {%- endif -%}
            {%- if section.settings.whatsapp_number != blank -%}
              <a
                href="https://wa.me/{{ section.settings.whatsapp_number }}"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="WhatsApp"
              >
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3Zm0 1.8a7.2 7.2 0 0 1 6.2 10.9c-.2.3-3 4.4-6.2 4.4a7.1 7.1 0 0 1-3.6-1l-.3-.2-2.6.7.7-2.5-.2-.3A7.2 7.2 0 0 1 12 4.8Zm-2.7 3.6c-.2 0-.5 0-.7.3-.2.3-.9.9-.9 2.1 0 1.2.9 2.4 1 2.6.1.2 1.8 2.8 4.4 3.8 2.2.9 2.6.7 3.1.6.5 0 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2-.1-.1-.3-.2-.6-.3l-1.7-.8c-.2-.1-.4-.1-.6.1l-.7.9c-.1.2-.3.2-.5.1-.3-.1-1.1-.4-2.1-1.3-.8-.7-1.3-1.6-1.5-1.9-.1-.2 0-.4.1-.5l.4-.5c.1-.2.2-.3.2-.5.1-.2 0-.4 0-.5l-.8-1.8c-.2-.4-.4-.4-.6-.4Z"></path>
                </svg>
              </a>
            {%- endif -%}
          </div>
        </div>

          {%- if has_institutional -%}
            <div class="sf-col">
              {%- if section.settings.institutional_heading != blank -%}
                <h5>{{ section.settings.institutional_heading }}</h5>
              {%- endif -%}
              <ul>
                {%- for block in section.blocks -%}
                  {%- if block.type == 'link' and block.settings.column == 'institutional' -%}
                    <li {{ block.shopify_attributes }}>
                      {%- liquid
                        assign link_url = block.settings.url | default: '#'
                        assign link_external = false
                        if link_url contains '://' or link_url contains 'wa.me'
                          assign link_external = true
                        endif
                      -%}
                      <a
                        href="{{ link_url }}"
                        {% if link_external %}target="_blank" rel="noopener noreferrer"{% endif %}
                      >
                        {{- block.settings.label -}}
                      </a>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          {%- if has_help -%}
            <div class="sf-col">
              {%- if section.settings.help_heading != blank -%}
                <h5>{{ section.settings.help_heading }}</h5>
              {%- endif -%}
              <ul>
                {%- for block in section.blocks -%}
                  {%- if block.type == 'link' and block.settings.column == 'help' -%}
                    <li {{ block.shopify_attributes }}>
                      {%- liquid
                        assign link_url = block.settings.url | default: '#'
                        assign link_external = false
                        if link_url contains '://' or link_url contains 'wa.me'
                          assign link_external = true
                        endif
                      -%}
                      <a
                        href="{{ link_url }}"
                        {% if link_external %}target="_blank" rel="noopener noreferrer"{% endif %}
                      >
                        {{- block.settings.label -}}
                      </a>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          {%- if has_contact -%}
            <div class="sf-col">
              {%- if section.settings.contact_heading != blank -%}
                <h5>{{ section.settings.contact_heading }}</h5>
              {%- endif -%}
              <ul>
                {%- for block in section.blocks -%}
                  {%- if block.type == 'link' and block.settings.column == 'contact' -%}
                    <li {{ block.shopify_attributes }}>
                      {%- if block.settings.url != blank -%}
                        {%- liquid
                          assign link_url = block.settings.url
                          assign link_external = false
                          if link_url contains '://' or link_url contains 'wa.me'
                            assign link_external = true
                          endif
                        -%}
                        <a
                          href="{{ link_url }}"
                          {% if link_external %}target="_blank" rel="noopener noreferrer"{% endif %}
                        >
                          {{- block.settings.label -}}
                        </a>
                      {%- else -%}
                        <span>{{ block.settings.label }}</span>
                      {%- endif -%}
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        </div>

        <div class="sf-bottom">
          <span>
            &copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright_owner | default: shop.name }}. {{ section.settings.copyright_text }}
          </span>
          {%- if section.settings.disclaimer != blank -%}
            <span>{{ section.settings.disclaimer }}</span>
          {%- endif -%}
        </div>
      </div>
    </div>
</footer>

{% schema %}
{
  "name": "Suppet footer",
  "settings": [
    { "type": "header", "content": "Marca" },
    { "type": "image_picker", "id": "logo", "label": "Logo (branco)" },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Descrição",
      "default": "Suppet é a linha de suplementos super premium mastigáveis da DrogaVET — reforço imunológico, proteção articular, equilíbrio digestivo e emocional para o seu pet."
    },
    { "type": "url", "id": "instagram_url", "label": "Instagram" },
    { "type": "url", "id": "facebook_url", "label": "Facebook" },
    { "type": "text", "id": "whatsapp_number", "label": "WhatsApp (só números, com DDI)", "default": "554132098989" },
    { "type": "header", "content": "Colunas de links" },
    { "type": "text", "id": "institutional_heading", "label": "Título da coluna 1", "default": "Institucional" },
    { "type": "text", "id": "help_heading", "label": "Título da coluna 2", "default": "Ajuda" },
    { "type": "text", "id": "contact_heading", "label": "Título da coluna 3", "default": "Contato (SAC)" },
    { "type": "header", "content": "Barra inferior" },
    { "type": "text", "id": "copyright_owner", "label": "Titular dos direitos", "default": "DrogaVET · Suppet" },
    { "type": "text", "id": "copyright_text", "label": "Texto complementar", "default": "Todos os direitos reservados." },
    { "type": "text", "id": "disclaimer", "label": "Aviso legal", "default": "Suplemento alimentar. Uso veterinário — para cães." },
    { "type": "header", "content": "Layout e cores" },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Largura do conteúdo",
      "min": 1100,
      "max": 1820,
      "step": 20,
      "unit": "px",
      "default": 1240
    },
    { "type": "color", "id": "background_color", "label": "Cor de fundo", "default": "#0E1B33" },
    { "type": "color", "id": "accent_color", "label": "Cor de destaque (hover dos ícones)", "default": "#D7282D" }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "settings": [
        {
          "type": "select",
          "id": "column",
          "label": "Coluna",
          "options": [
            { "value": "institutional", "label": "Institucional" },
            { "value": "help", "label": "Ajuda" },
            { "value": "contact", "label": "Contato (SAC)" }
          ],
          "default": "institutional"
        },
        { "type": "text", "id": "label", "label": "Texto", "default": "Link" },
        {
          "type": "text",
          "id": "url",
          "label": "URL",
          "info": "Aceita https, mailto, tel ou âncoras (#produtos, /#campanha)."
        }
      ]
    }
  ]
}
{% endschema %}
