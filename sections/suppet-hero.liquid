{%- comment -%}
  Suppet hero — porte da hero da LP estática (Suppet/index.html + css/style.css).
  Arquivo NOVO: não é sobrescrito por atualizações do tema Shapes.

  --sh-brand  cor fixa da marca (eyebrow, <em> do título, stats, dot ativo)
  --sh-accent cor do produto ativo (glow e tag) — muda a cada slide
{%- endcomment -%}

{%- liquid
  assign uid = section.id
  assign slides = section.blocks | where: 'type', 'slide'
  assign stats = section.blocks | where: 'type', 'stat'
  assign first_slide = slides.first

  assign first_accent = '#D7282D'
  if first_slide.settings.accent != blank
    assign first_accent = first_slide.settings.accent
  endif

  comment
    Modo estático: renderiza só o primeiro produto, sem dots, sem rotação,
    sem hover e sem nenhuma animação. Controlado por enable_motion.
  endcomment
  assign motion = section.settings.enable_motion
  assign visible_slides = slides
  if motion == false
    assign visible_slides = slides | slice: 0, 1
  endif
-%}

<style>
  #SuppetHero-{{ uid }} {
    --sh-brand: {{ section.settings.brand_color | default: '#DD6E1F' }};
    --sh-accent: {{ first_accent }};
    --sh-ease: cubic-bezier(0.4, 0, 0.2, 1);
    --sh-ease-out: cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: {{ section.settings.min_height }}vh;
  }

  /* Luz vinda do canto superior direito, como na LP */
  #SuppetHero-{{ uid }}::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background: radial-gradient(
      120% 140% at 78% 18%,
      rgba(var(--color-scheme-text), 0.12) 0%,
      transparent 55%
    );
    pointer-events: none;
  }

  #SuppetHero-{{ uid }} .sh-rays {
    position: absolute;
    inset: -10%;
    z-index: 0;
    opacity: 0.5;
    background: repeating-conic-gradient(
      from 0deg at 82% 30%,
      {{ section.settings.brand_color | default: '#DD6E1F' }}29 0deg 6deg,
      transparent 6deg 16deg
    );
    -webkit-mask-image: radial-gradient(circle at 82% 30%, #000 0%, transparent 62%);
    mask-image: radial-gradient(circle at 82% 30%, #000 0%, transparent 62%);
    pointer-events: none;
  }

  #SuppetHero-{{ uid }} .sh-content {
    position: relative;
    z-index: 2;
    width: 100%;
  }

  #SuppetHero-{{ uid }} .sh-grid {
    display: grid;
    grid-template-columns: 0.92fr 1.18fr;
    gap: 40px;
    align-items: center;
    /* A LP usa container de 1240px; o max-w-site do tema é 1820px,
       o que deixaria o pack pequeno demais em relação ao texto. */
    max-width: {{ section.settings.content_max_width }}px;
    margin-inline: auto;
  }

  #SuppetHero-{{ uid }} .sh-eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--heading-font-stack);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--sh-brand);
  }

  #SuppetHero-{{ uid }} .sh-eyebrow::before {
    content: '\2726';
  }

  #SuppetHero-{{ uid }} .sh-title {
    margin-top: 18px;
    max-width: 640px;
    font-size: clamp(34px, 5vw, 60px);
    font-weight: 800;
    line-height: 1.08;
  }

  #SuppetHero-{{ uid }} .sh-title em {
    font-style: normal;
    color: var(--sh-brand);
  }

  #SuppetHero-{{ uid }} .sh-text {
    margin-top: 20px;
    max-width: 480px;
    font-size: 18px;
    line-height: 1.65;
    color: rgba(var(--color-scheme-text), 0.72);
  }

  #SuppetHero-{{ uid }} .sh-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 36px;
  }

  #SuppetHero-{{ uid }} .sh-btn-outline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 30px;
    border-radius: var(--button-border-radius, 9999px);
    border: 2px solid rgba(var(--color-scheme-text), 0.5);
    color: rgb(var(--color-scheme-text));
    font-family: var(--heading-font-stack);
    font-weight: var(--heading-font-weight, 700);
    text-transform: var(--button-text-transform, none);
    line-height: 1.2;
    transition: background-color 0.3s var(--sh-ease), border-color 0.3s var(--sh-ease),
      transform 0.3s var(--sh-ease);
  }

  #SuppetHero-{{ uid }} .sh-btn-outline:hover {
    background: rgba(var(--color-scheme-text), 0.12);
    border-color: rgb(var(--color-scheme-text));
    transform: translateY(-3px);
  }

  /* LP: .btn-primary usa a cor de destaque (vermelho) da marca, não a
     cor de texto do scheme — o botão global do tema usa button_color=text,
     por isso sobrescrevemos só aqui dentro do hero. */
  #SuppetHero-{{ uid }} .sh-ctas .push-btn__surface {
    padding: 16px 30px;
    --color-button-background: var(--color-scheme-accent-1);
    --color-button-text: var(--color-scheme-accent-1-contrast);
    --color-button-border: var(--color-scheme-accent-1);
  }

  #SuppetHero-{{ uid }} .sh-ctas .push-btn:hover .push-btn__surface {
    --color-button-background-hover: var(--color-scheme-accent-1);
    --color-button-text-hover: var(--color-scheme-accent-1-contrast);
    --color-button-border-hover: var(--color-scheme-accent-1);
  }

  #SuppetHero-{{ uid }} .sh-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 34px;
    margin-top: 48px;
  }

  #SuppetHero-{{ uid }} .sh-stat b {
    display: block;
    font-family: var(--heading-font-stack);
    font-size: 26px;
    line-height: 1;
    color: var(--sh-brand);
  }

  #SuppetHero-{{ uid }} .sh-stat span {
    display: block;
    margin-top: 4px;
    font-size: 13px;
    color: rgba(var(--color-scheme-text), 0.6);
  }

  #SuppetHero-{{ uid }} .sh-art {
    position: relative;
    z-index: 2;
  }

  #SuppetHero-{{ uid }} .sh-showcase {
    position: relative;
    /* Tamanho final da LP (AJUSTES FINAIS — TAMANHOS E CARDS). */
    width: min(640px, 92%);
    margin: 0 auto;
    aspect-ratio: 1 / 1.1;
  }

  #SuppetHero-{{ uid }} .sh-glow {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 88%;
    height: 88%;
    z-index: 0;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    filter: blur(70px);
    opacity: 0.6;
    background-color: var(--sh-accent);
    transition: background-color 1.1s var(--sh-ease);
  }

  #SuppetHero-{{ uid }} .sh-ring {
    position: absolute;
    inset: 6%;
    z-index: 0;
    border-radius: 50%;
    border: 1.5px dashed rgba(var(--color-scheme-text), 0.16);
    animation: sh-spin-{{ uid }} 40s linear infinite;
  }

  #SuppetHero-{{ uid }} .sh-slides {
    position: relative;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  #SuppetHero-{{ uid }} .sh-slide {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: translateY(26px) scale(0.94) rotate(2deg);
    transition: opacity 0.85s var(--sh-ease-out), transform 0.85s var(--sh-ease-out);
    pointer-events: none;
  }

  #SuppetHero-{{ uid }} .sh-slide.is-active {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  #SuppetHero-{{ uid }} .sh-slide img,
  #SuppetHero-{{ uid }} .sh-slide .placeholder-svg {
    max-width: 88%;
    max-height: 100%;
    width: auto;
    cursor: pointer;
    filter: drop-shadow(0 40px 60px rgb(0 0 0 / 0.55));
    transition: transform 0.5s var(--sh-ease-out);
  }

  /* LP: .hero__slide img:hover — vale no slide ativo, tenha link ou não */
  #SuppetHero-{{ uid }} .sh-slide.is-active img:hover,
  #SuppetHero-{{ uid }} .sh-slide.is-active .placeholder-svg:hover,
  #SuppetHero-{{ uid }} .sh-slide.is-active a:hover img {
    transform: scale(1.035) rotate(-1deg);
  }

  /* LP: .btn-primary:hover / .btn:active */
  #SuppetHero-{{ uid }} .sh-ctas .push-btn {
    transition: transform 0.35s var(--sh-ease-out), box-shadow 0.35s var(--sh-ease-out);
  }

  #SuppetHero-{{ uid }} .sh-ctas .push-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 30px -8px rgba(var(--color-scheme-accent-1), 0.6);
  }

  #SuppetHero-{{ uid }} .sh-ctas .push-btn:active,
  #SuppetHero-{{ uid }} .sh-ctas .sh-btn-outline:active {
    transform: scale(0.97);
  }

  /* LP: .hero__dots — sem hover próprio, só realce sutil de affordance */
  #SuppetHero-{{ uid }} .sh-dots button:hover {
    background: rgba(var(--color-scheme-text), 0.45);
  }

  #SuppetHero-{{ uid }} .sh-tag {
    position: absolute;
    left: 50%;
    bottom: 2%;
    z-index: 2;
    transform: translateX(-50%);
    padding: 9px 20px;
    border-radius: 999px;
    white-space: nowrap;
    color: #fff;
    font-family: var(--heading-font-stack);
    font-weight: 700;
    font-size: 14px;
    background-color: var(--sh-accent);
    box-shadow: 0 16px 30px -12px rgb(0 0 0 / 0.5);
    transition: background-color 0.8s var(--sh-ease);
  }

  #SuppetHero-{{ uid }} .sh-dots {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 22px;
  }

  #SuppetHero-{{ uid }} .sh-dots button {
    width: 34px;
    height: 5px;
    padding: 0;
    border: none;
    border-radius: 4px;
    background: rgba(var(--color-scheme-text), 0.22);
    transition: background-color 0.5s var(--sh-ease), width 0.4s var(--sh-ease);
  }

  #SuppetHero-{{ uid }} .sh-dots button[aria-current='true'] {
    width: 52px;
    background: var(--sh-brand);
  }

  #SuppetHero-{{ uid }} .sh-badge {
    position: absolute;
    left: -6px;
    top: 6px;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 22px;
    border-radius: 999px;
    background: #fff;
    color: #0e1b33;
    font-family: var(--heading-font-stack);
    font-weight: 800;
    box-shadow: 0 20px 40px -14px rgb(0 0 0 / 0.4);
    animation: sh-floaty-{{ uid }} 4.5s ease-in-out infinite;
  }

  #SuppetHero-{{ uid }} .sh-badge span {
    display: block;
    font-size: 11px;
    font-weight: 700;
    color: #5b6b84;
  }

  #SuppetHero-{{ uid }} .sh-badge b {
    font-size: 20px;
    color: var(--sh-accent);
    transition: color 1.1s var(--sh-ease);
  }

  @keyframes sh-spin-{{ uid }} {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes sh-floaty-{{ uid }} {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  @media (max-width: 980px) {
    #SuppetHero-{{ uid }} .sh-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }
    #SuppetHero-{{ uid }} .sh-showcase {
      width: min(560px, 90%);
    }
    #SuppetHero-{{ uid }} .sh-eyebrow {
      justify-content: center;
    }
    #SuppetHero-{{ uid }} .sh-title,
    #SuppetHero-{{ uid }} .sh-text {
      margin-left: auto;
      margin-right: auto;
    }
    #SuppetHero-{{ uid }} .sh-ctas,
    #SuppetHero-{{ uid }} .sh-stats {
      justify-content: center;
    }
    #SuppetHero-{{ uid }} .sh-badge {
      left: 50%;
      transform: translateX(-50%);
    }
  }

  @media (max-width: 520px) {
    #SuppetHero-{{ uid }} .sh-showcase {
      width: min(420px, 88%);
    }
    #SuppetHero-{{ uid }} .sh-badge {
      left: 50%;
      top: -4px;
      transform: translateX(-50%);
    }
  }

  /* Modo estático — desliga toda a movimentação da seção */
  #SuppetHero-{{ uid }}[data-motion='false'] .sh-ring,
  #SuppetHero-{{ uid }}[data-motion='false'] .sh-badge {
    animation: none;
  }

  #SuppetHero-{{ uid }}[data-motion='false'] .sh-slide,
  #SuppetHero-{{ uid }}[data-motion='false'] .sh-slide img,
  #SuppetHero-{{ uid }}[data-motion='false'] .sh-slide .placeholder-svg,
  #SuppetHero-{{ uid }}[data-motion='false'] .sh-glow,
  #SuppetHero-{{ uid }}[data-motion='false'] .sh-tag,
  #SuppetHero-{{ uid }}[data-motion='false'] .push-btn,
  #SuppetHero-{{ uid }}[data-motion='false'] .sh-btn-outline {
    transition: none;
  }

  #SuppetHero-{{ uid }}[data-motion='false'] .sh-slide {
    opacity: 1;
    transform: none;
  }

  #SuppetHero-{{ uid }}[data-motion='false'] .sh-slide img,
  #SuppetHero-{{ uid }}[data-motion='false'] .sh-slide .placeholder-svg {
    cursor: default;
  }

  /* Nenhum deslocamento no hover/active */
  #SuppetHero-{{ uid }}[data-motion='false'] .sh-slide.is-active img:hover,
  #SuppetHero-{{ uid }}[data-motion='false'] .sh-slide.is-active .placeholder-svg:hover,
  #SuppetHero-{{ uid }}[data-motion='false'] .sh-slide.is-active a:hover img,
  #SuppetHero-{{ uid }}[data-motion='false'] .sh-ctas .push-btn:hover,
  #SuppetHero-{{ uid }}[data-motion='false'] .sh-ctas .push-btn:active,
  #SuppetHero-{{ uid }}[data-motion='false'] .sh-btn-outline:hover,
  #SuppetHero-{{ uid }}[data-motion='false'] .sh-ctas .sh-btn-outline:active {
    transform: none;
  }

  #SuppetHero-{{ uid }}[data-motion='false'] .sh-ctas .push-btn:hover {
    box-shadow: none;
  }

  @media (prefers-reduced-motion: reduce) {
    #SuppetHero-{{ uid }} .sh-ring,
    #SuppetHero-{{ uid }} .sh-badge {
      animation: none;
    }
    #SuppetHero-{{ uid }} .sh-slide {
      transition: opacity 0.25s linear;
      transform: none;
    }
  }
</style>

<section
  id="SuppetHero-{{ uid }}"
  class="relative overflow-hidden bg-scheme-background text-scheme-text {% if section.settings.use_gradient_background %}bg-scheme-gradient{% endif %}"
  data-color-scheme="{{ section.settings.color_scheme }}"
  data-suppet-hero
  data-motion="{{ section.settings.enable_motion }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-speed="{{ section.settings.speed }}"
>
  <div class="sh-rays"></div>

  <div class="sh-content section-content px-section py-section-vertical-spacing">
    <div class="mx-auto max-w-site sh-grid">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="sh-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}

        {%- if section.settings.title != blank -%}
          <h1 class="sh-title inline-heading-rte font-heading break-words">
            {{ section.settings.title }}
          </h1>
        {%- endif -%}

        {%- if section.settings.richtext != blank -%}
          <div class="sh-text rte font-main">{{ section.settings.richtext }}</div>
        {%- endif -%}

        {%- if section.settings.cta_primary_label != blank
          or section.settings.cta_secondary_label != blank
        -%}
          <div class="sh-ctas">
            {%- if section.settings.cta_primary_label != blank -%}
              <a href="{{ section.settings.cta_primary_url | default: '#' }}" class="push-btn inline-block">
                <span class="push-btn__surface">{{ section.settings.cta_primary_label }}</span>
              </a>
            {%- endif -%}
            {%- if section.settings.cta_secondary_label != blank -%}
              <a href="{{ section.settings.cta_secondary_url | default: '#' }}" class="sh-btn-outline">
                {{- section.settings.cta_secondary_label -}}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if stats.size > 0 -%}
          <div class="sh-stats">
            {%- for stat in stats -%}
              <div class="sh-stat" {{ stat.shopify_attributes }}>
                <b>{{ stat.settings.value }}</b>
                <span>{{ stat.settings.label }}</span>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="sh-art">
        {%- if section.settings.badge_value != blank -%}
          <div class="sh-badge">
            {%- if section.settings.badge_kicker != blank -%}
              <span>{{ section.settings.badge_kicker }}</span>
            {%- endif -%}
            <b>{{ section.settings.badge_value }}</b>
          </div>
        {%- endif -%}

        <div class="sh-showcase">
          <div class="sh-glow" data-sh-glow></div>
          <div class="sh-ring"></div>

          <div class="sh-slides">
            {%- if visible_slides.size > 0 -%}
              {%- for block in visible_slides -%}
                {%- assign accent = block.settings.accent | default: '#D7282D' -%}
                <div
                  class="sh-slide{% if forloop.first %} is-active{% endif %}"
                  data-sh-slide
                  data-accent="{{ accent }}"
                  data-name="{{ block.settings.name | escape }}"
                  data-index="{{ forloop.index0 }}"
                  {% unless forloop.first %}
                    aria-hidden="true"
                  {% endunless %}
                  {{ block.shopify_attributes }}
                >
                  {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{%- endif -%}
                  {%- if block.settings.image != blank -%}
                    {%- if forloop.first -%}
                      {{
                        block.settings.image
                        | image_url: width: 900
                        | image_tag:
                          widths: '300, 500, 700, 900',
                          sizes: '(min-width: 981px) 34vw, 80vw',
                          alt: block.settings.name,
                          loading: 'eager',
                          fetchpriority: 'high'
                      }}
                    {%- else -%}
                      {{
                        block.settings.image
                        | image_url: width: 900
                        | image_tag:
                          widths: '300, 500, 700, 900',
                          sizes: '(min-width: 981px) 34vw, 80vw',
                          alt: block.settings.name,
                          loading: 'lazy'
                      }}
                    {%- endif -%}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                  {%- if block.settings.link != blank -%}</a>{%- endif -%}
                </div>
              {%- endfor -%}
            {%- else -%}
              <div class="sh-slide is-active">
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {%- endif -%}
          </div>

          {%- if slides.size > 0 and first_slide.settings.name != blank -%}
            <span class="sh-tag" data-sh-tag>{{ first_slide.settings.name }}</span>
          {%- endif -%}
        </div>

        {%- if motion and slides.size > 1 -%}
          <div class="sh-dots">
            {%- for block in slides -%}
              <button
                type="button"
                data-sh-dot
                data-index="{{ forloop.index0 }}"
                aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-label="{{ block.settings.name | escape }}"
              ></button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    function initSuppetHero(root) {
      if (!root || root.dataset.shReady === 'true') return;
      root.dataset.shReady = 'true';

      // Modo estático: nenhum listener, nenhum timer.
      if (root.dataset.motion === 'false') return;

      var slides = Array.prototype.slice.call(root.querySelectorAll('[data-sh-slide]'));
      if (slides.length === 0) return;

      var dots = Array.prototype.slice.call(root.querySelectorAll('[data-sh-dot]'));
      var tag = root.querySelector('[data-sh-tag]');
      var speed = parseInt(root.dataset.speed, 10) || 3800;
      var autoplay = root.dataset.autoplay === 'true';
      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var current = 0;
      var timer = null;

      function goTo(index) {
        current = ((index % slides.length) + slides.length) % slides.length;

        slides.forEach(function (slide, i) {
          var active = i === current;
          slide.classList.toggle('is-active', active);
          if (active) slide.removeAttribute('aria-hidden');
          else slide.setAttribute('aria-hidden', 'true');
        });

        dots.forEach(function (dot, i) {
          dot.setAttribute('aria-current', i === current ? 'true' : 'false');
        });

        var accent = slides[current].dataset.accent;
        if (accent) root.style.setProperty('--sh-accent', accent);

        var name = slides[current].dataset.name;
        if (tag && name) tag.textContent = name;
      }

      function stop() {
        if (timer) {
          clearInterval(timer);
          timer = null;
        }
      }

      function start() {
        stop();
        if (!autoplay || reduced || slides.length < 2) return;
        timer = setInterval(function () {
          goTo(current + 1);
        }, speed);
      }

      dots.forEach(function (dot) {
        dot.addEventListener('click', function () {
          goTo(parseInt(dot.dataset.index, 10));
          start();
        });
      });

      root.addEventListener('mouseenter', stop);
      root.addEventListener('mouseleave', start);
      root.addEventListener('focusin', stop);
      root.addEventListener('focusout', start);

      document.addEventListener('visibilitychange', function () {
        if (document.hidden) stop();
        else start();
      });

      goTo(0);
      start();
    }

    function initAll() {
      Array.prototype.forEach.call(
        document.querySelectorAll('[data-suppet-hero]'),
        initSuppetHero
      );
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }

    document.addEventListener('shopify:section:load', function (event) {
      var root = event.target.querySelector('[data-suppet-hero]');
      if (root) initSuppetHero(root);
    });
  })();
</script>

{% schema %}
{
  "name": "Suppet hero",
  "tag": "section",
  "class": "suppet-hero-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Suplementos Super Premium"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Título",
      "default": "O <em>power up</em> na saúde e na longevidade do seu pet."
    },
    {
