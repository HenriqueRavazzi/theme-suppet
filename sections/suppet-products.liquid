{%- comment -%}
  Suppet products (Os 4 superpoderes) — porte do bloco "products"/".prod-card"
  da LP estática (Suppet/index.html + css/style.css, seção id="produtos").
  Arquivo NOVO: não é sobrescrito por atualizações do tema Shapes.
{%- endcomment -%}

{%- liquid
  assign uid = section.id
  assign products = section.blocks | where: 'type', 'product'
-%}

<style>
  #SuppetProducts-{{ uid }} {
    position: relative;
    overflow: hidden;
  }

  #SuppetProducts-{{ uid }}::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background: radial-gradient(60% 60% at 90% 0%, rgba(47, 163, 156, 0.18), transparent 70%),
      radial-gradient(50% 50% at 0% 100%, rgba(215, 40, 45, 0.14), transparent 70%);
    pointer-events: none;
  }

  #SuppetProducts-{{ uid }} .sp-container {
    position: relative;
    z-index: 1;
    /* A LP usa container de 1240px; o max-w-site do tema é 1820px. */
    max-width: {{ section.settings.content_max_width | default: 1240 }}px;
    margin-inline: auto;
  }

  #SuppetProducts-{{ uid }} .sp-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--heading-font-stack);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: {{ section.settings.brand_color | default: '#DD6E1F' }};
  }

  #SuppetProducts-{{ uid }} .sp-eyebrow::before {
    content: '';
    width: 22px;
    height: 3px;
    border-radius: 3px;
    background: currentColor;
  }

  #SuppetProducts-{{ uid }} .sp-title {
    margin-top: 12px;
    font-size: clamp(28px, 4vw, 44px);
    font-weight: 800;
    line-height: 1.1;
  }

  #SuppetProducts-{{ uid }} .sp-sub {
    margin-top: 14px;
    max-width: 560px;
    font-size: 17px;
    line-height: 1.6;
    color: rgba(var(--color-scheme-text), 0.65);
  }

  #SuppetProducts-{{ uid }} .sp-scroller {
    position: relative;
    margin-top: 40px;
  }

  #SuppetProducts-{{ uid }} .sp-track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(280px, 1fr);
    gap: 26px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 4px 4px 12px;
    scrollbar-width: none;
  }

  #SuppetProducts-{{ uid }} .sp-track::-webkit-scrollbar {
    display: none;
  }

  #SuppetProducts-{{ uid }} .sp-card {
    scroll-snap-align: start;
    background: #fff;
    color: #0e1b33;
    border-radius: 28px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 20px 44px -24px rgba(0, 0, 0, 0.5);
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  #SuppetProducts-{{ uid }} .sp-card:hover {
    transform: translateY(-12px);
    box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.55);
  }

  #SuppetProducts-{{ uid }} .sp-card__media {
    position: relative;
    /* height fixa (não min-height): embalagens com proporções levemente
       diferentes não podem esticar o card e desalinhar o título abaixo.
       330px é o valor final da LP (@media min-width:1200px). */
    height: 330px;
    /* Padding lateral/superior >= border-radius do card (28px): abaixo
       disso, os cantos arredondados do .sp-card cortavam a ponta da
       embalagem quando a imagem preenchia a largura toda da caixa. */
    padding: 28px 28px 0;
    background: #16264a;
    /* Sem isto, a sombra do filter: drop-shadow() da imagem (que cresce
       junto no hover) vazava pra fora da área azul, sobre o fundo
       branco do corpo do card. */
    overflow: hidden;
  }

  #SuppetProducts-{{ uid }} .sp-card__media img {
    display: block;
    /* Não usa 100%/100%: a caixa da imagem (área de transform) ficava do
       tamanho do quadro inteiro, então o zoom do hover girava/escalava
       a partir do centro do quadro — não do centro do pack — e cortava
       a embalagem na borda. Com margem fixa, sempre sobra espaço. */
    width: 90%;
    height: 90%;
    margin: 0 auto;
    object-fit: contain;
    object-position: center bottom;
    filter: drop-shadow(0 26px 28px rgba(0, 0, 0, 0.42));
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  #SuppetProducts-{{ uid }} .sp-card:hover .sp-card__media img {
    transform: scale(1.05) rotate(-1deg);
  }

  #SuppetProducts-{{ uid }} .sp-card__body {
    padding: 22px 24px 26px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }

  /* Na LP, o selo do produto é texto (.prod-card__body .tagline) no
     corpo do card, não um pill sobre a imagem. */
  #SuppetProducts-{{ uid }} .sp-card__tagline {
    font-family: var(--heading-font-stack);
    font-weight: 700;
    font-size: 12.5px;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    color: var(--sp-accent, #d7282d);
  }

  #SuppetProducts-{{ uid }} .sp-card__body h3 {
    font-size: 20px;
    color: #0e1b33;
  }

  #SuppetProducts-{{ uid }} .sp-card__campaign-line {
    font-size: 13px;
    font-weight: 800;
    color: #5b6b84;
  }

  #SuppetProducts-{{ uid }} .sp-card__mission,
  #SuppetProducts-{{ uid }} .sp-card__powers,
  #SuppetProducts-{{ uid }} .sp-card__allies {
    padding-top: 10px;
    border-top: 1px solid #e4e7ec;
  }

  #SuppetProducts-{{ uid }} .sp-card__mission b,
  #SuppetProducts-{{ uid }} .sp-card__powers b,
  #SuppetProducts-{{ uid }} .sp-card__allies b {
    display: block;
    margin-bottom: 5px;
    font-family: var(--heading-font-stack);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.65px;
    text-transform: uppercase;
    color: #0e1b33;
  }

  #SuppetProducts-{{ uid }} .sp-card__mission p,
  #SuppetProducts-{{ uid }} .sp-card__allies p {
    font-size: 12.5px;
    line-height: 1.48;
    color: #5b6b84;
  }

  #SuppetProducts-{{ uid }} .sp-card__powers ul {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  #SuppetProducts-{{ uid }} .sp-card__powers li {
    position: relative;
    padding-left: 14px;
    font-size: 12.25px;
    line-height: 1.35;
    color: #5b6b84;
  }

  #SuppetProducts-{{ uid }} .sp-card__powers li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.52em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.65;
  }

  #SuppetProducts-{{ uid }} .sp-card__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 14px;
  }

  #SuppetProducts-{{ uid }} .sp-card__price {
    font-family: var(--heading-font-stack);
    font-weight: 800;
    font-size: 19px;
    color: #0e1b33;
  }

  #SuppetProducts-{{ uid }} .sp-card__price span {
    display: block;
    font-size: 11px;
    font-weight: 600;
    color: #5b6b84;
  }

  #SuppetProducts-{{ uid }} .sp-card__go {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: #fff;
    background: var(--sp-accent, #d7282d);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  #SuppetProducts-{{ uid }} .sp-card__go svg {
    width: 18px;
    height: 18px;
  }

  #SuppetProducts-{{ uid }} .sp-card:hover .sp-card__go {
    transform: translateX(4px) rotate(-45deg);
  }

  @media (max-width: 900px) {
    #SuppetProducts-{{ uid }} .sp-card__media {
      height: 320px;
    }
  }

  @media (max-width: 640px) {
    #SuppetProducts-{{ uid }} .sp-track {
      grid-auto-columns: minmax(78%, 1fr);
    }
    #SuppetProducts-{{ uid }} .sp-card__media {
      height: 290px;
    }
  }
</style>

<section
  id="SuppetProducts-{{ uid }}"
  class="bg-scheme-background text-scheme-text {% if section.settings.use_gradient_background %}bg-scheme-gradient{% endif %}"
  data-color-scheme="{{ section.settings.color_scheme }}"
>
  <span id="produtos" class="visually-hidden" tabindex="-1"></span>
  <div class="section-content px-section py-section-vertical-spacing">
    <div class="sp-container">
      {%- if section.settings.eyebrow != blank -%}
        <p class="sp-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h2 class="sp-title inline-heading-rte font-heading break-words">
          {{ section.settings.title }}
        </h2>
      {%- endif -%}

      {%- if section.settings.richtext != blank -%}
        <div class="sp-sub rte font-main">{{ section.settings.richtext }}</div>
      {%- endif -%}

      {%- if products.size > 0 -%}
        <div class="sp-scroller">
          <div class="sp-track" data-sp-track>
            {%- for block in products -%}
              {%- liquid
                assign p = all_products[block.settings.product]

                assign card_name = p.title
                if block.settings.name != blank
                  assign card_name = block.settings.name
                endif

                assign card_link = p.url
                if block.settings.link != blank
                  assign card_link = block.settings.link
                endif

                # De propósito, NÃO usa p.featured_image aqui: a foto real do
                # produto no Shopify normalmente não tem a margem de respiro
                # ao redor do pack que as artes "pack-*.webp" têm, e isso
                # cortava a embalagem no zoom do hover.
                assign card_image = block.settings.image
              -%}
              <article class="sp-card" style="--sp-accent: {{ block.settings.accent }};" {{ block.shopify_attributes }}>
                <div class="sp-card__media">
                  {%- if card_image != blank -%}
                    {{
                      card_image
                      | image_url: width: 500
                      | image_tag: widths: '250, 350, 500', sizes: '280px', alt: card_name, loading: 'lazy'
                    }}
                  {%- else -%}
                    {%- assign fallback_pack = 'pack-vitaforca.webp' -%}
                    {%- case forloop.index0 -%}
                      {%- when 1 -%}
                        {%- assign fallback_pack = 'pack-condroprotetor.webp' -%}
                      {%- when 2 -%}
                        {%- assign fallback_pack = 'pack-anticopro.webp' -%}
                      {%- when 3 -%}
                        {%- assign fallback_pack = 'pack-estresse.webp' -%}
                    {%- endcase -%}
                    <img
                      src="{{ fallback_pack | asset_url }}"
                      alt="{{ card_name | default: 'Suppet' }}"
                      loading="lazy"
                      width="1497"
                      height="1974"
                    >
                  {%- endif -%}
                </div>
                <div class="sp-card__body">
                  {%- if block.settings.tagline != blank -%}
                    <p class="sp-card__tagline">{{ block.settings.tagline }}</p>
                  {%- endif -%}
                  {%- if card_name != blank -%}<h3>{{ card_name }}</h3>{%- endif -%}
                  {%- if block.settings.campaign_line != blank -%}
                    <p class="sp-card__campaign-line">{{ block.settings.campaign_line }}.</p>
                  {%- endif -%}
                  {%- if block.settings.mission != blank -%}
                    <div class="sp-card__mission">
                      <b>Missão</b>
                      <p>{{ block.settings.mission }}</p>
                    </div>
                  {%- endif -%}
                  {%- if block.settings.powers != blank -%}
                    <div class="sp-card__powers">
                      <b>Superpoderes ativados</b>
                      <ul>
                        {%- assign power_lines = block.settings.powers | newline_to_br | split: '<br />' -%}
                        {%- for power in power_lines -%}
                          {%- assign power = power | strip -%}
                          {%- if power != blank -%}<li>{{ power }}</li>{%- endif -%}
                        {%- endfor -%}
                      </ul>
                    </div>
                  {%- endif -%}
                  {%- if block.settings.allies != blank -%}
                    <div class="sp-card__allies">
                      <b>Aliados da missão</b>
                      <p>{{ block.settings.allies }}</p>
                    </div>
                  {%- endif -%}
                  <div class="sp-card__foot">
                    <div class="sp-card__price">
                      {%- if p != blank -%}
                        {{ p.price | money }}
                      {%- else -%}
                        {{ block.settings.price }}
                      {%- endif -%}
                      {%- if block.settings.price_note != blank -%}
                        <span>{{ block.settings.price_note }}</span>
                      {%- endif -%}
                    </div>
                    <a
                      href="{{ card_link | default: '#' }}"
                      class="sp-card__go"
                      aria-label="{{ 'general.pagination.next' | t }} {{ card_name }}"
                    >
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M9 5l7 7-7 7"></path>
                      </svg>
                    </a>
                  </div>
                </div>
              </article>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Suppet products",
  "tag": "section",
  "class": "suppet-products-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Linha Suppet"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Título",
      "default": "Os 4 superpoderes do seu pet"
    },
    {
      "type": "richtext",
      "id": "richtext",
      "label": "Texto",
      "default": "<p>Cada fórmula ativa um superpoder diferente — escolha o suplemento ideal para a rotina do seu companheiro.</p>"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Largura do conteúdo",
      "min": 1100,
      "max": 1820,
      "step": 20,
      "unit": "px",
      "default": 1240
    },
    { "type": "header", "content": "Cores" },
    {
      "type": "color",
      "id": "brand_color",
      "label": "Cor da marca (eyebrow)",
      "default": "#DD6E1F"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de cores",
      "default": "scheme3"
    },
    {
      "type": "checkbox",
      "id": "use_gradient_background",
      "label": "Usar fundo gradiente",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Produto",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Produto da loja",
          "info": "Nome, preço, imagem e link vêm deste produto. Os campos abaixo só sobrescrevem quando preenchidos."
        },
        { "type": "text", "id": "tagline", "label": "Selo (sobre a imagem)", "default": "Superpoder" },
        { "type": "color", "id": "accent", "label": "Cor do produto", "default": "#D7282D" },
        { "type": "header", "content": "Narrativa da missão" },
        {
          "type": "text",
          "id": "campaign_line",
          "label": "Frase de impacto",
          "info": "Ex.: \"A defesa da vitalidade\" — o ponto final é adicionado automaticamente."
        },
        { "type": "textarea", "id": "mission", "label": "Missão" },
        { "type": "textarea", "id": "powers", "label": "Superpoderes ativados", "info": "Um por linha." },
        {
          "type": "text",
          "id": "allies",
          "label": "Aliados da missão",
          "info": "Ex.: \"EPA + DHA • Taurina • Biotina • Zinco • Beta-glucanos\""
        },
        { "type": "header", "content": "Sobrescrever produto (opcional)" },
        { "type": "image_picker", "id": "image", "label": "Imagem do pack" },
        { "type": "text", "id": "name", "label": "Nome" },
        { "type": "text", "id": "price", "label": "Preço (se não houver produto selecionado)" },
        { "type": "text", "id": "price_note", "label": "Legenda do preço", "default": "caixa com 30 sachês" },
        { "type": "url", "id": "link", "label": "Link do produto" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Suppet products",
      "blocks": [
        {
          "type": "product",
          "settings": {
            "tagline": "Reforço Imunológico e Suporte Nutricional",
            "name": "Campo de Vitaforça",
            "campaign_line": "A defesa da vitalidade",
            "mission": "Oferecer energia e suporte nutricional para as aventuras do dia a dia.",
            "powers": "Auxilia o metabolismo energético;\nFortalece a imunidade;\nFavorece pele e pelagem;\nSaúde intestinal;\nAção antioxidante.",
            "allies": "EPA + DHA • Taurina • Biotina • Zinco • Beta-glucanos",
            "accent": "#D7282D"
          }
        },
        {
          "type": "product",
          "settings": {
            "tagline": "Proteção para as Articulações",
            "name": "Escudo Condroprotetor",
            "campaign_line": "A proteção da mobilidade",
            "mission": "Proteger as articulações para que nenhuma aventura precise parar.",
            "powers": "Auxilia a saúde articular;\nProtege a cartilagem;\nFavorece a mobilidade;\nContribui para o conforto;\nMais qualidade de vida.",
            "allies": "Glucosamina • Condroitina • Colágeno Tipo II",
            "accent": "#DD6E1F"
          }
        },
        {
          "type": "product",
          "settings": {
            "tagline": "Redução do Hábito de Ingestão das Fezes",
            "name": "Barreira AntiCopro",
            "campaign_line": "A potência da saúde intestinal",
            "mission": "Impedir que a coprofagia atrapalhe o bem-estar do seu herói.",
            "powers": "Auxilia no controle da coprofagia;\nFavorece a saúde intestinal;\nReduz o odor das fezes;\nMelhora a digestibilidade dos nutrientes;\nAlta palatabilidade.",
            "allies": "Yucca • Probióticos • Prebióticos • Enzimas Digestivas",
            "accent": "#3A7CAE"
          }
        },
        {
          "type": "product",
          "settings": {
            "tagline": "Equilíbrio e Bem-Estar",
            "name": "Neutralizador de Estresse",
            "campaign_line": "A diferença do equilíbrio",
            "mission": "Transformar momentos desafiadores em mais tranquilidade.",
            "powers": "Auxilia no controle do estresse e da ansiedade;\nPromove relaxamento;\nFavorece o equilíbrio comportamental;\nSuporte ao sistema nervoso;\nIdeal para viagens, fogos e mudanças de rotina.",
            "allies": "L-Triptofano • L-Teanina • Camomila • Melissa • Valeriana",
            "accent": "#2FA39C"
          }
        }
      ]
    }
  ]
}
{% endschema %}
